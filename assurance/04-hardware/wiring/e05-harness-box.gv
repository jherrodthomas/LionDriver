 <tr><td>
  <table border="0" cellspacing="0" cellpadding="3" cellborder="1"><tr>
   <td balign="left">Molex 501876-1840</td>
   <td balign="left">box header, mates with Toyota A plug X3</td>
   <td balign="left">18-pin</td>
  </tr></table>
 </td></tr>
 <tr><td>
  <table border="0" cellspacing="0" cellpadding="3" cellborder="1">
   <tr>
    <td>GND (to J3 A1)</td>
    <td port="p1r">1</td>
   </tr>
