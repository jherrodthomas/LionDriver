   </tr>
   <tr>
    <td>CAN1_H radar (to J3 A11)</td>
    <td port="p8r">8</td>
   </tr>
   <tr>
    <td>CAN1_H radar (to J3 A11)</td>
    <td port="p9r">9</td>
   </tr>
   <tr>
    <td>VIN (to J3 A4)</td>
    <td port="p10r">10</td>
   </tr>
   <tr>
    <td>CAN1_L radar (to J3 A10)</td>
    <td port="p11r">11</td>
   </tr>
   <tr>
    <td>VIN (to J3 A4)</td>
    <td port="p12r">12</td>
   </tr>
   <tr>
    <td>CAN2_L term. select</td>
    <td port="p13r">13</td>
   </tr>
   <tr>
    <td>IGN_12 (camera; same net as 2)</td>
    <td port="p14r">14</td>
   </tr>
   <tr>
    <td>CAN2_L'' to R8</td>
    <td port="p15r">15</td>
   </tr>
   <tr>
    <td>CAN2_H camera</td>
    <td port="p16r">16</td>
   </tr>
   <tr>
    <td>GND (to J3 A1)</td>
    <td port="p17r">17</td>
   </tr>
   <tr>
    <td>CAN2_L camera</td>
    <td port="p18r">18</td>
   </tr>
  </table>
 </td></tr>
 <tr><td>
  <table border="0" cellspacing="0" cellpadding="3" cellborder="1"><tr>
   <td balign="left">Lines show the switched and sensed nets only; pins marked 'to J3' are plain PCB nets. A loopback in the plug adds R6 (3-5) or R8 (13-15).</td>
  </tr></table>
 </td></tr>
</table>
