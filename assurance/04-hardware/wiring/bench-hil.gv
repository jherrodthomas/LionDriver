   <td balign="left">orientation and ignition simulation (panda/tests/hitl/test_9_harness.py)</td>
   <td balign="left">8-pin</td>
  </tr></table>
 </td></tr>
 <tr><td>
  <table border="0" cellspacing="0" cellpadding="3" cellborder="1">
   <tr>
    <td>USB</td>
    <td port="p1r">1</td>
   </tr>
