	CAN [label=<
<table border="0" cellspacing="0" cellpadding="0">
 <tr><td>
  <table border="0" cellspacing="0" cellpadding="3" cellborder="1"><tr>
   <td balign="left">CAN</td>
  </tr></table>
 </td></tr>
 <tr><td>
  <table border="0" cellspacing="0" cellpadding="3" cellborder="1"><tr>
   <td balign="left">CAN interface, 2 channels</td>
   <td balign="left">500 kbit/s; model recorded on the checklist</td>
   <td balign="left">6-pin</td>
  </tr></table>
 </td></tr>
 <tr><td>
  <table border="0" cellspacing="0" cellpadding="3" cellborder="1">
   <tr>
    <td>A CAN_H</td>
    <td port="p1r">1</td>
   </tr>
   <tr>
    <td>A CAN_L</td>
    <td port="p2r">2</td>
   </tr>
   <tr>
    <td>A GND</td>
    <td port="p3r">3</td>
   </tr>
   <tr>
    <td>B CAN_H</td>
    <td port="p4r">4</td>
   </tr>
   <tr>
    <td>B CAN_L</td>
    <td port="p5r">5</td>
   </tr>
   <tr>
    <td>B GND</td>
    <td port="p6r">6</td>
   </tr>
  </table>
 </td></tr>
 <tr><td>
  <table border="0" cellspacing="0" cellpadding="3" cellborder="1"><tr>
   <td balign="left">Ch A sends 0x343 every 10 ms, ch B sends 0x1AA every 10 ms; both log error counters.</td>
  </tr></table>
 </td></tr>
</table>
> fillcolor="#FFFFFF" shape=box style=filled]
	X1 [label=<
