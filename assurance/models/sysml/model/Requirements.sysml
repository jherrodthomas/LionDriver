    requirement <'SYS-102'> sys_102 : SystemRequirement {
        doc /* LDW shall warn when not laterally engaged, above 31 mph, with no turn signal in the last 5 s, when the vehicle drifts toward a visible lane line. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.plannerd";
        :>> functionId = "F-06, F-07";
        :>> reqType = "F";
        :>> target = "as stated";
        :>> verifMethod = "T-SIL";
    }
    requirement <'SYS-120'> sys_120 : SystemRequirement {
        doc /* In normal operation inside the ODD, the envelope shall not reject any command produced by the SoC controller (no false interventions). */
        :>> workProduct = "WP-S-01";
        :>> allocText = "E-03a";
        :>> functionId = "F-08";
        :>> reqType = "P";
        :>> target = "safetyTxBlocked increments per hour of engaged driving = 0 (excluding intentional tests, and excluding frames refused by design: STEERING_LKA frames refused by the EPS-fault gate at fault onset (TSR-110) and frames rejected by the TX rate supervision (TSR-518), reference build, added 2026-10-12)";
        :>> verifMethod = "LOG";
    }
    requirement <'SYS-121'> sys_121 : SystemRequirement {
        doc /* The envelope shall report its mode, parameter, authority state, fault flags and counters to the SoC at ≥ 10 Hz. */
        :>> workProduct = "WP-S-01";
