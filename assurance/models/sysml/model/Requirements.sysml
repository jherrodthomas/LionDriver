    requirement <'CSR-024'> csr_024 : CybersecurityRequirement {
        doc /* Softloader entry (0xd1 param 1) shall be accepted only while the panda is in a non-actuating mode and the vehicle ignition is off. */
        :>> workProduct = "WP-S-07";
