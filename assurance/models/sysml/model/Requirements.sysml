    requirement <'CSR-011'> csr_011 : CybersecurityRequirement {
        doc /* Release panda firmware for the reference configuration shall accept a car safety mode only if model, parameter and alternative experience equal the compile-time locked values recorded in the release record. */
        :>> workProduct = "WP-S-07";
        :>> allocText = "FW";
        :>> group = "CSR-C-01";
        :>> safetyRelation = "TSR-512, FSR-01.10, B‡";
        :>> verifMethod = "R, UT, HIL";
    }
    requirement <'CSR-012'> csr_012 : CybersecurityRequirement {
        doc /* A rejected safety-configuration request shall leave the panda in a non-actuating mode and set a fault flag reported to the SoC in the health packet. */
        :>> workProduct = "WP-S-07";
        :>> allocText = "FW";
        :>> group = "CSR-C-01";
        :>> safetyRelation = "TSR-512, B‡";
        :>> verifMethod = "UT, HIL";
    }
    requirement <'CSR-013'> csr_013 : CybersecurityRequirement {
