    }
    requirement <'SYS-100'> sys_100 : SystemRequirement {
        doc /* FCW shall alert when the model predicts hard braking or the planner predicts a collision. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.selfdrived, host.modeld";
        :>> functionId = "F-06, F-07";
        :>> reqType = "F";
        :>> target = "as stated";
        :>> verifMethod = "T-SIL";
    }
    requirement <'SYS-101'> sys_101 : SystemRequirement {
