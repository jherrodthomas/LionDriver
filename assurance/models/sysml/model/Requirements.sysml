    }
    requirement <'FSR-06.02'> fsr_06_02 : FunctionalSafetyRequirement {
        doc /* On detected loss, the item shall give a take-over request within 1 s and cancel ACC so that control returns to the driver; it shall not hold a stale acceleration command. */
        :>> workProduct = "WP-C-04";
        :>> allocText = "E-01, E-03";
        :>> asil = "C";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'FSR-06.03'> fsr_06_03 : FunctionalSafetyRequirement {
        doc /* The item shall detect that the PCM does not execute ACC (ACC fault, cruise fault) and warn the driver. */
        :>> workProduct = "WP-C-04";
        :>> allocText = "E-01";
        :>> asil = "C";
        :>> verifMethod = "T-SIL";
    }
    requirement <'FSR-06.04'> fsr_06_04 : FunctionalSafetyRequirement {
        doc /* Non-finite or out-of-range actuator commands shall be treated as faults with a fault reaction, not silently replaced. */
        :>> workProduct = "WP-C-04";
        :>> allocText = "E-01, E-03";
        :>> asil = "C";
        :>> verifMethod = "T-SIL";
    }
    requirement <'FSR-06.05'> fsr_06_05 : FunctionalSafetyRequirement {
        doc /* FSR-02.05 (independent acoustic warning on SoC loss) and FSR-02.06…02.09 (DM) also serve SG-06. */
        :>> workProduct = "WP-C-04";
        :>> allocText = "as ref.";
        :>> asil = "as ref.";
        :>> verifMethod = "as ref.";
    }
    requirement <'FSR-07.01'> fsr_07_01 : FunctionalSafetyRequirement {
        doc /* The item shall forward all camera-side messages to the car side unchanged, except the defined set of intercepted control messages. */
        :>> workProduct = "WP-C-04";
        :>> allocText = "E-03";
        :>> asil = "B";
        :>> verifMethod = "T-SIL, T-HIL";
    }
    requirement <'FSR-07.02'> fsr_07_02 : FunctionalSafetyRequirement {
        doc /* The item shall not originate any message that the stock PCS function uses (e.g. PRE_COLLISION 0x344, PCS_HUD 0x411, AEB 0x283 with content) in the reference configuration. */
        :>> workProduct = "WP-C-04";
        :>> allocText = "E-03";
        :>> asil = "B";
        :>> verifMethod = "R, T-SIL";
    }
    requirement <'FSR-07.03'> fsr_07_03 : FunctionalSafetyRequirement {
        doc /* On safety-MCU fault, loss of device power, or harness fault, the relay shall return to the stock camera-to-vehicle connection. */
        :>> workProduct = "WP-C-04";
        :>> allocText = "E-05, E-03";
        :>> asil = "B";
        :>> verifMethod = "A, T-HIL";
    }
    requirement <'FSR-07.04'> fsr_07_04 : FunctionalSafetyRequirement {
        doc /* openpilot longitudinal commands shall not prevent PCS braking from taking priority in the PCM. (External measure, AOU-04R) */
        :>> workProduct = "WP-C-04";
        :>> allocText = "EXT-PCM";
        :>> asil = "— (ext.)";
        :>> verifMethod = "T-VEH";
    }
    requirement <'FSR-07.05'> fsr_07_05 : FunctionalSafetyRequirement {
        doc /* The item shall inform the driver when the stock system reports an AEB or FCW event. */
        :>> workProduct = "WP-C-04";
        :>> allocText = "E-01";
        :>> asil = "QM";
        :>> verifMethod = "T-SIL";
    }
    requirement <'FSR-07.06'> fsr_07_06 : FunctionalSafetyRequirement {
        doc /* If the harness cannot return to the stock camera-to-vehicle connection (switch or relay stuck in intercept, detected by state readback), the item shall inhibit all actuation, warn the driver that stock PCS/AEB is unavailable, and refuse engagement until the harness is repaired. (Accepted 2026-10-14 as the degraded state, DQ-064; applies once readback exists.) */
        :>> workProduct = "WP-C-04";
        :>> allocText = "E-03 (detection), E-05 (readback), E-01/HMI (warning)";
        :>> asil = "B";
        :>> verifMethod = "T-HIL, FI";
    }
    requirement <'FSR-07.07'> fsr_07_07 : FunctionalSafetyRequirement {
        doc /* While the stock system reports an AEB event, the item shall request zero acceleration from the PCM (no added drive), so that stock AEB braking does not depend on PCM arbitration alone. FSR-07.04 and its AOU-04R test still apply. (Decided 2026-10-18, DQ-300 A; System FMEA SFM-036, SFM-ACT-020; FTA MCS-07.10.) */
        :>> workProduct = "WP-C-04";
        :>> allocText = "E-01";
        :>> asil = "QM (no ASIL claim; FSR-07.04 stays the measure)";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'FSR-08.01'> fsr_08_01 : FunctionalSafetyRequirement {
        doc /* While engaged, the item shall give the first driver alert within 6 s of the loss of attention, measured end to end from the driver's change of state to the alert (including camera frame time, DM model latency and policy timers), and shall reach the no-response reaction of FSR-02.09 within the time set in WP-S-04 (assurance/03-system/WP-S-04-timing-ftti-budget.md). */
        :>> workProduct = "WP-C-04";
        :>> allocText = "E-01/DM, E-01/HMI";
        :>> asil = "A";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-101'> tsr_101 : TechnicalSafetyRequirement {
        doc /* The envelope shall reject every STEERING_LKA (0x2E4) frame whose STEER_TORQUE_CMD magnitude exceeds the torque bound τ_max(v) of TSR-102. Until TSR-102 is implemented, τ_max is the baseline 1500 raw. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "B‡";
        :>> mechanism = "LIM";
        :>> timing = "per frame / frame rejected (then TSR-108, TSR-109)";
        :>> verifMethod = "A, T-SIL, T-VEH";
    }
    requirement <'TSR-102'> tsr_102 : TechnicalSafetyRequirement {
        doc /* τ_max(v) shall be a speed-dependent lookup derived on the reference vehicle by (1) characterising the steady-state lateral acceleration and wheel torque produced by raw requests 0…1500 at speeds 10…120 km/h (AOU-01R), (2) choosing per speed the largest request whose worst-case lateral deviation over the driver intervention time stays inside the bound of WP-S-04 §3 (assurance/03-system/WP-S-04-timing-ftti-budget.md), and (3) confirming controllability C1 for that bound with the tests of WP-C-08 (assurance/02-concept/WP-C-08-driver-hmi-misuse-analysis.md) §8. The speed value used shall be the one that yields the smaller torque bound when the speed estimate is uncertain. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW (+ calibration data, WP-W-09 (assurance/05-software/WP-W-09-configuration-calibration-data.md))";
        :>> asil = "B‡";
        :>> mechanism = "LIM";
        :>> timing = "per frame";
        :>> verifMethod = "A, T-SIL, T-VEH";
    }
    requirement <'TSR-103'> tsr_103 : TechnicalSafetyRequirement {
        doc /* The envelope shall reject a 0x2E4 frame whose torque lies outside [min(r, 0) − Δ, max(r, 0) + Δ], where r is the previous frame's torque and Δ = Δ_up for the frame rate check, or r is the torque at the start of the current real-time window and Δ = Δ_rt for the window check; the window restarts with the first frame more than 250 ms after its start. So a rise in magnitude, or a crossing of zero, by more than Δ (from r or from 0) is rejected, and these two checks accept any change toward zero: a fall toward zero is the safe direction for SG-01, and a bounded ramp of torque withdrawn on a fault is FSR-02.04's. While the command exceeds the measured EPS torque by more than Δ_meas, it shall fall by at least Δ_down per frame (TSR-104). A frame still beyond that bound after a smaller fall toward zero is rejected. After a rejected frame, or while authority is not granted, the reference for these checks is 0. The values shall be derived from the onset rate accepted in the controllability tests; the baseline values are Δ_up 15 and Δ_down 25 raw per frame and Δ_rt 450 raw per 250 ms. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "B‡";
        :>> mechanism = "LIM";
        :>> timing = "per frame";
        :>> verifMethod = "A, T-SIL";
    }
    requirement <'TSR-104'> tsr_104 : TechnicalSafetyRequirement {
        doc /* The envelope shall reject 0x2E4 frames whose torque exceeds the measured EPS motor torque (0x260 STEER_TORQUE_EPS scaled by the EPS factor of the safety parameter) by more than Δ_meas (measured from 0 when the measured torque is of the opposite sign), using the minimum/maximum of the last 6 samples widened by 1 raw, unless the frame falls toward zero by at least Δ_down from the previous frame (TSR-103). Baseline Δ_meas = 350 raw. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "B‡";
        :>> mechanism = "LIM, PLB";
        :>> timing = "per frame";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-105'> tsr_105 : TechnicalSafetyRequirement {
        doc /* While lateral authority is not granted, the envelope shall reject every 0x2E4 frame with non-zero torque or with STEER_REQUEST set. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "B‡";
        :>> mechanism = "GATE";
        :>> timing = "per frame";
        :>> verifMethod = "T-SIL, T-HIL";
    }
    requirement <'TSR-106'> tsr_106 : TechnicalSafetyRequirement {
        doc /* While authority is granted, the envelope shall accept STEER_REQUEST = 0 with non-zero torque for at most 1 consecutive frame, only after ≥ 17 consecutive valid frames and ≥ 162 ms after the previous cut. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "B‡";
        :>> mechanism = "GATE";
        :>> timing = "per frame";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-107'> tsr_107 : TechnicalSafetyRequirement {
        doc /* In the reference configuration (LKA torque path) the envelope shall reject any STEERING_LTA (0x191) frame that carries a steering request, a non-zero angle command or a non-zero torque wind-down, and shall accept 0x2E4 only with its specified length (5 bytes). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "B‡";
        :>> mechanism = "GATE";
        :>> timing = "per frame";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-108'> tsr_108 : TechnicalSafetyRequirement {
        doc /* If the envelope rejects a lateral command frame while lateral authority is granted, it shall revoke lateral authority (SS-L) and keep it revoked until a new valid engagement (TSR-301), and it shall report the event and its cause to the SoC. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "B‡";
        :>> mechanism = "FR";
        :>> timing = "detect: same frame / react: same frame";
        :>> verifMethod = "T-SIL, FI";
    }
    requirement <'TSR-109'> tsr_109 : TechnicalSafetyRequirement {
        doc /* Whenever the envelope rejects a 0x2E4 frame or revokes lateral authority, the EPS shall receive torque 0 with STEER_REQUEST 0 within ≤ 0.1 s. This shall be achieved by (a) the envelope transmitting, in place of each rejected frame, a 0x2E4 frame with zero torque, STEER_REQUEST 0, a counter continuing the host sequence and a valid checksum; or (b) only if vehicle characterisation shows that the EPS ramps LKA torque to zero within ≤ 0.1 s of a missing 0x2E4 frame, by withholding the frame. Option (a) is the recommended design. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW (a); EXT (b)";
        :>> asil = "C";
        :>> mechanism = "FR";
        :>> timing = "react ≤ 0.1 s";
        :>> verifMethod = "T-HIL, T-VEH, FI";
    }
    requirement <'TSR-110'> tsr_110 : TechnicalSafetyRequirement {
        doc /* The envelope shall receive EPS_STATUS (0x262) and, while lateral authority is granted, shall revoke lateral authority and report the cause when LKA_STATE indicates an EPS fault or LKA unavailability, or when EPS_STATUS is missing beyond its timeout (TSR-401). The LKA_STATE fault code set shall be confirmed for the reference EPS firmware. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW (detect); SoC (warn, TSR-606)";
        :>> asil = "C";
        :>> mechanism = "PLB, TMO";
        :>> timing = "detect ≤ 0.3 s / react ≤ 0.1 s";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-111'> tsr_111 : TechnicalSafetyRequirement {
        doc /* The EPS shall limit the LKA torque at the steering wheel to ≤ T_EPS for any 0x2E4 request and remove LKA torque within t_EPS after 0x2E4 stops or STEER_REQUEST clears. (External measure; T_EPS and t_EPS to be measured.) */
        :>> workProduct = "WP-S-02";
        :>> allocText = "EXT";
        :>> asil = "ext";
        :>> mechanism = "EXTM";
        :>> timing = "t_EPS TBD";
        :>> verifMethod = "T-VEH";
    }
    requirement <'TSR-201'> tsr_201 : TechnicalSafetyRequirement {
        doc /* The envelope shall reject every ACC_CONTROL (0x343) frame whose ACCEL_CMD exceeds a_max, where a_max is derived from the controllability of HE-03.1…03.3 on the reference vehicle. Baseline a_max = +2.0 m/s² (raw 2000). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "LIM";
        :>> timing = "per frame";
        :>> verifMethod = "A, T-SIL, T-VEH";
    }
    requirement <'TSR-202'> tsr_202 : TechnicalSafetyRequirement {
        doc /* The envelope shall reject every 0x343 frame whose ACCEL_CMD is below a_min, derived from the controllability of HE-04.1 (following traffic). Baseline a_min = −3.5 m/s² (raw −3500). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "B";
        :>> mechanism = "LIM";
        :>> timing = "per frame";
        :>> verifMethod = "A, T-SIL, T-VEH";
    }
    requirement <'TSR-203'> tsr_203 : TechnicalSafetyRequirement {
        doc /* While longitudinal authority is not granted (not engaged, or accelerator pressed per TSR-305), the envelope shall accept 0x343 only with the inactive acceleration value. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "GATE";
        :>> timing = "per frame";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-204'> tsr_204 : TechnicalSafetyRequirement {
        doc /* The envelope shall reject 0x343 frames whose ACCEL_CMD increases, relative to the last accepted value (the inactive value counting as 0 m/s² at engagement), faster than j_up, derived from controllability. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "LIM";
        :>> timing = "per frame";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-205'> tsr_205 : TechnicalSafetyRequirement {
        doc /* The envelope shall reject 0x343 frames whose ACCEL_CMD decreases (deceleration onset) faster than j_down, derived from following-traffic controllability. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "B";
        :>> mechanism = "LIM";
        :>> timing = "per frame";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-206'> tsr_206 : TechnicalSafetyRequirement {
        doc /* On revocation of longitudinal authority the transition to SS-G shall not cause a vehicle deceleration or acceleration step beyond the jerk bounds of TSR-204/205. If the PCM response to a step from the last commanded value to the inactive value is not shown to be bounded (AOU-05R), the envelope shall accept a commanded value that winds down to the inactive value at no more than j_down/j_up for at most 1 s after revocation. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW, EXT";
        :>> asil = "C";
        :>> mechanism = "FR";
        :>> timing = "react ≤ 0.3 s to SS-G start";
        :>> verifMethod = "A, T-VEH";
    }
    requirement <'TSR-207'> tsr_207 : TechnicalSafetyRequirement {
        doc /* For 0x343, the envelope shall also check the actuation-relevant fields PERMIT_BRAKING, CANCEL_REQ, RELEASE_STANDSTILL and ACCEL_CMD_ALT against the values allowed in the current authority state, and while authority is not granted shall accept only frames that do not request acceleration, braking or standstill release. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "GATE";
        :>> timing = "per frame";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-208'> tsr_208 : TechnicalSafetyRequirement {
        doc /* The PCM shall bound ACC acceleration requests to its own ACC envelope, honour CANCEL_REQ, and produce coasting without a deceleration step on the inactive value. (External measure.) */
        :>> workProduct = "WP-S-02";
        :>> allocText = "EXT";
        :>> asil = "ext";
        :>> mechanism = "EXTM";
        :>> timing = "—";
        :>> verifMethod = "T-VEH";
    }
    requirement <'TSR-301'> tsr_301 : TechnicalSafetyRequirement {
        doc /* The envelope shall grant actuation authority only on the rising edge of PCM_CRUISE (0x1D2) CRUISE_ACTIVE, and only once the SoC heartbeat reports the item engaged within 1 s of that edge (otherwise not until the next rising edge), and shall revoke it in the same frame in which CRUISE_ACTIVE is received false (cancel, main switch off, PCM-internal drop). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "GATE";
        :>> timing = "detect ≤ 1 period (30 ms at 33 Hz) / same frame";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-302'> tsr_302 : TechnicalSafetyRequirement {
        doc /* The envelope shall revoke all actuation authority when a driver brake press is received (rising edge, or pressed while the vehicle is moving). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "B";
        :>> mechanism = "GATE";
        :>> timing = "detect ≤ 1 period (25 ms at 40 Hz) / same frame; SS-L via TSR-109";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-303'> tsr_303 : TechnicalSafetyRequirement {
        doc /* On every fault-induced disengagement, with or without openpilot longitudinal, the SoC shall set CANCEL_REQ so that the PCM drops ACC. The PCM cruise state then changes, which changes the cluster cruise indication (TSR-309, AOU-12) and makes the envelope revoke (TSR-301); a cancel without effect is caught by TSR-516(c). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (C-sup: TSR-203, TSR-301, TSR-516)";
        :>> mechanism = "FR";
        :>> timing = "≤ 0.1 s after disengagement";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-304'> tsr_304 : TechnicalSafetyRequirement {
        doc /* The envelope shall monitor STEER_TORQUE_DRIVER (0x260) on the LKA path and (a) reject 0x2E4 frames that increase torque opposing the driver beyond a driver allowance (driver-limited check in addition to the measured-torque check of TSR-104), and (b) when the driver torque exceeds T_ovr for longer than t_ovr, back off: accept only frames whose torque does not oppose the driver more than the previous frame, so that the commanded torque falls toward zero at no less than the Δ_down rate and stays there while the override lasts, and report the override state to the SoC (TSR-628). Lateral authority is kept, so assistance resumes when the driver releases (decided 2026-10-14, DQ-053: back off on override and show a cue; WP-A-05 LS-01, LS-02). T_ovr, t_ovr and the allowance shall be derived from the override behaviour accepted in WP-C-08 (assurance/02-concept/WP-C-08-driver-hmi-misuse-analysis.md) and from the EPS override threshold (AOU-02R). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "B (SG-05); B‡ (SG-01, HE-05.2)";
        :>> mechanism = "PLB, GATE";
        :>> timing = "detect ≤ 2 frames of 0x260 (40 ms) + t_ovr, with t_ovr ≤ 0.1 s / torque decreasing the next frame, so the back-off starts ≤ 0.2 s after the driver's input (SG-05, WP-S-04 §3.7; SFM-ACT-016)";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-305'> tsr_305 : TechnicalSafetyRequirement {
        doc /* While the accelerator is pressed (PCM_CRUISE GAS_RELEASED = 0), the envelope shall withdraw longitudinal authority (inactive value only, TSR-203). The accelerator shall not revoke lateral authority in the reference configuration unless the HMI decision in WP-C-08 changes DisengageOnAccelerator. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "B";
        :>> mechanism = "GATE";
        :>> timing = "detect ≤ 1 period / same frame";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-306'> tsr_306 : TechnicalSafetyRequirement {
        doc /* The envelope shall not grant actuation authority while any RX check of TSR-401…405 is failed, including timeouts not yet evaluated by the periodic check. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "GATE";
        :>> timing = "per frame";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-307'> tsr_307 : TechnicalSafetyRequirement {
        doc /* (a) The envelope shall revoke authority when the SoC heartbeat has reported "not engaged" continuously for 0.3 s while authority is granted; an "engaged" heartbeat restarts the count. (b) The SoC shall immediately disable when the envelope's reported authority differs from its own engaged state for > 0.3 s. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW (a); SoC (b)";
        :>> asil = "(a) C; (b) QM (C-sup)";
        :>> mechanism = "PLB";
        :>> timing = "(a) ≤ 0.3 s / same tick; (b) ≤ 0.3 s";
        :>> verifMethod = "T-HIL, FI";
    }
    requirement <'TSR-308'> tsr_308 : TechnicalSafetyRequirement {
        doc /* If PCM cruise is active while the item is not engaged, or the item is engaged while PCM cruise is inactive, for longer than 1 s, the SoC shall warn the driver and request ACC cancel. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (C-sup: TSR-301)";
        :>> mechanism = "PLB, WRN";
        :>> timing = "≤ 1 s";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-309'> tsr_309 : TechnicalSafetyRequirement {
        doc /* The engagement state enforced by the envelope shall be the PCM cruise state, so that the vehicle's cluster cruise indicator is an indication of engagement independent of the item's HMI. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW, EXT";
        :>> asil = "C";
        :>> mechanism = "DES";
        :>> timing = "—";
        :>> verifMethod = "A, T-VEH";
    }
    requirement <'TSR-310'> tsr_310 : TechnicalSafetyRequirement {
        doc /* Driver brake application shall produce braking regardless of 0x343 content, and the PCM shall drop ACC on brake. (External measure.) */
        :>> workProduct = "WP-S-02";
        :>> allocText = "EXT";
        :>> asil = "ext";
        :>> mechanism = "EXTM";
        :>> timing = "—";
        :>> verifMethod = "T-VEH";
    }
    requirement <'TSR-311'> tsr_311 : TechnicalSafetyRequirement {
        doc /* Actuation authority shall be false at MCU start-up and after every safety-mode change, and all limiter state (last torque, rate windows, samples) shall be reset. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "GATE";
        :>> timing = "—";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-401'> tsr_401 : TechnicalSafetyRequirement {
        doc /* For each RX message used for gating or limiting (0xAA, 0x260, 0x1D2, 0x226, and 0x262, 0x1D3, 0xB4 once added), the envelope shall detect absence longer than 5 nominal periods and shall evaluate this at ≥ 50 Hz, so that worst-case detection is ≤ 0.2 s. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "TMO";
        :>> timing = "detect ≤ 0.2 s / react ≤ 0.1 s";
        :>> verifMethod = "T-SIL, T-HIL, FI";
    }
    requirement <'TSR-402'> tsr_402 : TechnicalSafetyRequirement {
        doc /* The envelope shall verify the Toyota checksum and the message length of every RX message that carries a checksum (0x260, 0x1D2, and 0x262, 0x1D3, 0xB4 once added) and treat one failed frame as an RX fault. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "E2E";
        :>> timing = "per frame";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-403'> tsr_403 : TechnicalSafetyRequirement {
        doc /* The envelope shall detect when an RX message arrives at more than 1.5× its nominal rate over a 100 ms window (indicating duplicated or inserted frames) and treat it as an RX fault. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "PLB";
        :>> timing = "detect ≤ 0.1 s";
        :>> verifMethod = "T-SIL, FI";
    }
    requirement <'TSR-404'> tsr_404 : TechnicalSafetyRequirement {
        doc /* For RX signals that vary in normal operation, the envelope shall detect a frozen payload: an identical data field (excluding checksum) for longer than t_frz while the vehicle is moving (0x260 torque/angle bytes; 0xAA wheel speeds above a minimum speed; 0xB4 ENCODER). t_frz shall be set from fork-owned drive logs so that no false detection occurs in the reference log set. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "PLB";
        :>> timing = "detect ≤ t_frz (target ≤ 0.2 s)";
        :>> verifMethod = "LOG, T-SIL, FI";
    }
    requirement <'TSR-405'> tsr_405 : TechnicalSafetyRequirement {
        doc /* The envelope shall apply these cross-checks and treat a disagreement lasting longer than its tolerance time as an RX fault: (a) wheel-speed mean (0xAA) vs SPEED (0xB4) within 2 m/s; (b) BRAKE_PRESSED in 0x226 vs PCM_CRUISE_2 (0x1D3) BRAKE_PRESSED — on disagreement the envelope shall assume "brake pressed" (revoke); (c) CRUISE_ACTIVE = 1 shall imply PCM_CRUISE_2 MAIN_ON = 1; (d) while authority is granted, measured EPS torque shall follow the accepted command within an EPS-response tolerance (detects frozen or replaced 0x260). Signal availability and tolerances shall be confirmed on reference-vehicle logs. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "PLB (cross-channel)";
        :>> timing = "detect ≤ 0.2 s";
        :>> verifMethod = "LOG, T-SIL, FI";
    }
    requirement <'TSR-406'> tsr_406 : TechnicalSafetyRequirement {
        doc /* On any RX fault of TSR-401…405, the envelope shall revoke all actuation authority within ≤ 0.1 s (SS-L via TSR-109, SS-G), report a fault-specific reason code to the SoC, and not grant authority again until all checks pass and a new PCM rising edge occurs. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "FR";
        :>> timing = "react ≤ 0.1 s";
        :>> verifMethod = "T-SIL, FI";
    }
    requirement <'TSR-407'> tsr_407 : TechnicalSafetyRequirement {
        doc /* In a car safety mode, the envelope shall detect absence of the SoC heartbeat (0xf3) for > 0.3 s and then revoke all actuation authority at once (SS-L, SS-G). It shall enter SS-S (SILENT, relay released) after the longer timeout of TSR-510. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "TMO";
        :>> timing = "detect ≤ 0.3 s / react ≤ 0.1 s";
        :>> verifMethod = "T-HIL, FI";
    }
    requirement <'TSR-408'> tsr_408 : TechnicalSafetyRequirement {
        doc /* While lateral authority is granted, the envelope shall monitor the arrival of 0x2E4 frames from the SoC and, if no frame arrives for > 50 ms (5 frames), revoke authority and command SS-L (TSR-109). While longitudinal authority is granted, the same shall apply to 0x343 with a gap > 100 ms. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "TMO";
        :>> timing = "detect ≤ 50 / 100 ms / react ≤ 0.1 s";
        :>> verifMethod = "T-HIL, FI";
    }
    requirement <'TSR-409'> tsr_409 : TechnicalSafetyRequirement {
        doc /* The heartbeat shall carry evidence that the control loop is alive (e.g. the latest carControl frame counter), and the envelope shall treat a heartbeat whose evidence has not advanced for > 0.3 s as a missing heartbeat. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW, SoC";
        :>> asil = "C (panda check); QM (SoC content)";
        :>> mechanism = "TMO";
        :>> timing = "≤ 0.3 s";
        :>> verifMethod = "T-HIL, FI";
    }
    requirement <'TSR-410'> tsr_410 : TechnicalSafetyRequirement {
        doc /* Every SPI transfer (header and data) shall be protected by a CRC whose residual error probability over the maximum transfer length meets the target set in WP-S-05 §4 (assurance/03-system/WP-S-05-hsi-specification.md), and every CAN-TX transfer shall carry a sequence counter; the envelope shall discard transfers with a failed CRC or a repeated or out-of-order counter. The per-packet XOR may remain as an additional check. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW, SoC";
        :>> asil = "C";
        :>> mechanism = "E2E";
        :>> timing = "per transfer";
        :>> verifMethod = "A, T-HIL, FI";
    }
    requirement <'TSR-411'> tsr_411 : TechnicalSafetyRequirement {
        doc /* The envelope shall reject actuation frames whose transfer counter shows they are older than 2 control periods relative to the newest accepted transfer (freshness). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "E2E";
        :>> timing = "per transfer";
        :>> verifMethod = "T-HIL, FI";
    }
    requirement <'TSR-412'> tsr_412 : TechnicalSafetyRequirement {
        doc /* The envelope shall validate every length field received over SPI against its buffer size before starting a DMA transfer or copy, and every control-request parameter used as an array index against the array bounds; a violation shall be NACKed and counted as an SPI error. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "ISO, PLB";
        :>> timing = "per transfer";
        :>> verifMethod = "R, T-HIL, FI";
    }
    requirement <'TSR-413'> tsr_413 : TechnicalSafetyRequirement {
        doc /* If SPI errors (header/data checksum failures, NACKs) exceed a rate threshold while authority is granted, the envelope shall revoke authority and report. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "FR";
        :>> timing = "≤ 0.3 s";
        :>> verifMethod = "T-HIL, FI";
    }
    requirement <'TSR-501'> tsr_501 : TechnicalSafetyRequirement {
        doc /* The safety MCU shall be supervised by an independent hardware watchdog (IWDG1, LSI-clocked) that is started no later than the first time the harness relay is energised after a reset, by any path (safety-mode change or configuration/debug command), and then stays active until the next reset; that cannot be stopped by the SoC; that is serviced only after the periodic safety processing has completed; and that resets the MCU within ≤ 0.1 s of a stall (SG-07 FDTI, WP-S-04 (assurance/03-system/WP-S-04-timing-ftti-budget.md) §3.6; ≤ 0.2 s would meet SG-01 only). Rationale for the start condition (amended in v0.4): until the relay is first energised after a reset, the stock camera-to-vehicle path is intact and no actuation frame reaches the vehicle, so a stall cannot violate SG-01 or SG-07; an idle device keeps its power-save and stop modes. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-HW (cfg), P-SW";
        :>> asil = "C";
        :>> mechanism = "WDG";
        :>> timing = "detect ≤ 0.1 s / reset → SS-S";
        :>> verifMethod = "R, T-HIL, FI";
    }
    requirement <'TSR-502'> tsr_502 : TechnicalSafetyRequirement {
        doc /* Every detected MCU fault (watchdog, interrupt-rate, register divergence, memory ECC, clock, supply, temperature, SPI/DMA, siren, relay) shall lead to SS-S within ≤ 0.1 s of detection. Faults shall be classified as latching until power cycle or as recoverable, by documented rationale. During and after any reset the outputs shall be in SS-S until a valid safety mode is set. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW, P-HW";
        :>> asil = "C";
        :>> mechanism = "FR";
        :>> timing = "react ≤ 0.1 s";
        :>> verifMethod = "R, FI";
    }
    requirement <'TSR-503'> tsr_503 : TechnicalSafetyRequirement {
        doc /* Memory faults that can corrupt actuation decisions shall be detected: RAM ECC with double-error reaction, flash image CRC at start-up and periodically, and periodic check of safety-critical configuration registers, each leading to TSR-502. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-HW (cfg), P-SW";
        :>> asil = "C";
        :>> mechanism = "ST, PLB";
        :>> timing = "≤ 0.2 s for RAM/register faults; flash: start-up + background";
        :>> verifMethod = "R, FI";
    }
    requirement <'TSR-504'> tsr_504 : TechnicalSafetyRequirement {
        doc /* Loss or drift of the MCU clock that would invalidate timing checks or CAN bit timing shall be detected and lead to TSR-502. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-HW (cfg), P-SW";
        :>> asil = "C";
        :>> mechanism = "PLB";
        :>> timing = "≤ 0.2 s";
        :>> verifMethod = "FI";
    }
    requirement <'TSR-505'> tsr_505 : TechnicalSafetyRequirement {
        doc /* Supply voltage of the MCU outside its operating range shall lead to reset or SS-S (brown-out reset, programmable voltage detector), and vehicle input voltage out of range while the relay is driven shall lead to SS-S. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-HW, P-SW";
        :>> asil = "C";
        :>> mechanism = "PLB";
        :>> timing = "≤ 0.2 s";
        :>> verifMethod = "T-HIL";
    }
    requirement <'TSR-506'> tsr_506 : TechnicalSafetyRequirement {
        doc /* The intercept relay shall be de-energise-to-safe, its actual state shall be read back and compared with the commanded state in both directions within ≤ 0.3 s, and a detected relay malfunction shall inhibit all actuation TX and be latched until power cycle (not cleared by a safety-mode change). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-HW, HAR, P-SW";
        :>> asil = "C (blocking), B (PCS restore)";
        :>> mechanism = "PLB, FR";
        :>> timing = "detect ≤ 0.3 s";
        :>> verifMethod = "A, T-HIL, FI";
    }
    requirement <'TSR-507'> tsr_507 : TechnicalSafetyRequirement {
        doc /* Safety-critical data (safety mode and parameter, limits, authority state, relay state) and the stacks shall be protected against writes from communication handlers by the MPU, with a stack guard, and a MemManage fault shall lead to TSR-502. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-HW (cfg), P-SW";
        :>> asil = "C";
        :>> mechanism = "ISO";
        :>> timing = "—";
        :>> verifMethod = "R, FI";
    }
    requirement <'TSR-508'> tsr_508 : TechnicalSafetyRequirement {
        doc /* The car-side CAN transceiver shall be non-transmitting from reset until enabled by firmware; bus-off or persistent TX failure on the car-side bus while authority is granted shall revoke authority and be reported. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-HW, P-SW";
        :>> asil = "C";
        :>> mechanism = "FR";
        :>> timing = "≤ 0.3 s";
        :>> verifMethod = "T-HIL, FI";
    }
    requirement <'TSR-509'> tsr_509 : TechnicalSafetyRequirement {
        doc /* MCU die temperature outside its specified range shall lead to SS-S. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-HW, P-SW";
        :>> asil = "C";
        :>> mechanism = "PLB";
        :>> timing = "≤ 1 s";
        :>> verifMethod = "T-HIL";
    }
    requirement <'TSR-510'> tsr_510 : TechnicalSafetyRequirement {
        doc /* Ignition state shall be sensed from the harness ignition line; loss of the SoC heartbeat shall lead to SS-S after ≤ 2 s regardless of the ignition reading, and a failed ignition input shall not keep the relay driven without a heartbeat. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-HW, HAR, P-SW";
        :>> asil = "B";
        :>> mechanism = "TMO";
        :>> timing = "SS-S ≤ 2 s";
        :>> verifMethod = "A, T-HIL";
    }
    requirement <'TSR-511'> tsr_511 : TechnicalSafetyRequirement {
        doc /* Only release-signed LionDriver firmware shall execute on the safety MCU: the bootstub shall verify an ECDSA signature over P-256 with SHA-256 (decided 2026-10-19, DQ-191 A; replaces RSA-1024/SHA-1), flash read-out and write protection shall be set, the SoC's control of STM_BOOT0/STM_RST_N shall not allow non-release code to drive the relay, release builds of pandad shall not flash a development bootstub, and softloader entry (0xd1 param 1) shall be refused in a car safety mode and while the ignition is on (CSR-024). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW, P-HW (option bytes), SoC";
        :>> asil = "C (+ CS)";
        :>> mechanism = "CFG";
        :>> timing = "—";
        :>> verifMethod = "R, T-HIL";
    }
    requirement <'TSR-512'> tsr_512 : TechnicalSafetyRequirement {
        doc /* In release builds for the reference configuration the safety MCU shall accept only the modes SILENT, NOOUTPUT, ELM327 (fingerprinting, relay released) and TOYOTA with the reference safety parameter compiled into the firmware (EPS factor 73, no flags). Once TOYOTA mode is active, it shall accept only a change to NOOUTPUT or SILENT; any other request shall be rejected and reported. The alternative-experience word shall likewise be fixed to the reference value in release builds, so that it cannot be changed in a non-car mode and carried into a later TOYOTA session. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "CFG";
        :>> timing = "per request";
        :>> verifMethod = "R, T-HIL";
    }
    requirement <'TSR-513'> tsr_513 : TechnicalSafetyRequirement {
        doc /* In release builds, control requests that can change actuation, relay, CAN configuration or comms state shall be rejected while a car safety mode is active: at least 0xc5 (relay drive), 0xe5 (CAN loopback), 0xde/0xf9/0xfc/0xe8 (bit rate and CAN-FD configuration), 0xdb (OBD multiplexing), 0xe6 (clock source), 0xe7 (power save; in car mode it stops camera-side forwarding with the relay energised, SG-07, WP-A-04 SPF-08), 0xf1 (queue clear), 0xd1 param 1 (softloader entry, see also TSR-511), 0xd8 (MCU reset without fault reporting), 0xdf (alternative experience, see TSR-512). Also 0xc0 (comms reset), 0xb0/0xb1 and 0xf6 (to be confirmed per WP-W-02 OI-5). A refused request is ignored: it shall not change the actuation state, and it does not by itself end actuation authority (decided 2026-10-19, DQ-082 B; the alternative, withdrawing authority and reporting it as RR-2026-009 F-36 and CSR-012 propose, was not chosen, so CSR-012's intent stays an open item of the cybersecurity case, WP-S-07 (assurance/03-system/WP-S-07-cybersecurity-requirements-architecture.md)). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "CFG";
        :>> timing = "per request";
        :>> verifMethod = "R, T-HIL";
    }
    requirement <'TSR-514'> tsr_514 : TechnicalSafetyRequirement {
        doc /* Release firmware shall be built without ALLOW_DEBUG, with the LionDriver release key, and shall not contain the ALLOUTPUT mode, debug-only safety modes or debug-key acceptance; the build type shall be readable through the version request and recorded in the release record. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW (build)";
        :>> asil = "C (+ CS)";
        :>> mechanism = "CFG";
        :>> timing = "—";
        :>> verifMethod = "R";
    }
    requirement <'TSR-515'> tsr_515 : TechnicalSafetyRequirement {
        doc /* At every power-up, before the relay is first driven, the safety MCU shall run start-up tests of its safety mechanisms (flash CRC, RAM test of safety data regions, watchdog reset path at a defined interval, relay drive and readback, siren path) and stay in SS-S and report if any test fails. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW, P-HW";
        :>> asil = "C";
        :>> mechanism = "ST";
        :>> timing = "once per drive cycle";
        :>> verifMethod = "T-HIL, FI";
    }
    requirement <'TSR-516'> tsr_516 : TechnicalSafetyRequirement {
        doc /* The safety MCU shall sound its own acoustic warning within ≤ 0.5 s of detection (except as stated below for (b) on an EPS fault), without depending on SoC software, for at least 3 s or for as long as its condition holds if longer, at a level audible over the cabin noise of the reference vehicle (level set by WP-S-04 M-05), when (a) the SoC heartbeat is lost (TSR-407) while authority is granted; if authority ended within the 5 s before the loss, a warning within ≤ 5 s of the loss is sufficient, because the driver has already been told of the disengagement (decided 2026-10-14, DQ-061 A); (b) the envelope revokes authority while it is granted for any reason other than a driver action that the envelope itself observes (brake press, TSR-302; PCM cruise inactive, TSR-301), that is on missing SoC command frames (TSR-408), an RX fault (TSR-406), an EPS fault state (TSR-110), a rejected command (TSR-108), a car-side TX failure or bus-off (TSR-508) or a platform fault (TSR-502); or (c) PCM cruise is still active 0.5 s (within one 10 ms task period) after the SoC heartbeat first reported "not engaged" (a fault-induced disengagement whose ACC cancel, TSR-303, had no effect); or (d) the safety MCU restarts after a watchdog or fault reset (TSR-501, TSR-502) that interrupted granted authority. For (b) on an EPS fault, this clause replaces the ≤ 0.5 s bound: detection is the first fault frame, any persistence filter before the warning shall be ≤ 0.7 s, and the siren shall sound within the SG-02 1 s warning budget from fault onset (decided 2026-10-14, DQ-048). For (d), the item's engaged state shall be kept across the reset in memory that the reset does not clear, and the siren shall sound ≤ 0.5 s after the restart (decided 2026-10-14, DQ-054). A stalled SoC stops both the command frames and the heartbeat; whichever of TSR-408 and TSR-407 revokes first shall sound the siren under (b) or (a), so that a SoC stall is never silent, while a disengagement by the driver stays silent (decided 2026-10-19, DQ-404 A). A revocation on a heartbeat "not engaged" (TSR-307(a)) sounds the siren under (c), not (b): only if PCM cruise is still active 0.5 s after the first such heartbeat, so that a disengagement openpilot ends with an ACC cancel stays silent (cancel-lag guard, decided by the lead 2026-10-21; the PCM cancel lag is to be measured, WP-W-02 OI-18). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW, P-HW";
        :>> asil = "C";
        :>> mechanism = "WRN";
        :>> timing = "≤ 0.5 s after detection";
        :>> verifMethod = "T-HIL";
    }
    requirement <'TSR-517'> tsr_517 : TechnicalSafetyRequirement {
        doc /* Corruption of an approved actuation frame after the TX hook (copy into FDCAN message RAM, message RAM, FDCAN core, transceiver) shall be detected, e.g. by reading back the safety MCU's own transmitted frames on the car-side bus and comparing them with the approved frame, and a mismatch shall lead to TSR-502. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW, P-HW";
        :>> asil = "C";
        :>> mechanism = "PLB";
        :>> timing = "≤ 2 frames / react per TSR-502";
        :>> verifMethod = "A, FI";
    }
    requirement <'TSR-518'> tsr_518 : TechnicalSafetyRequirement {
        doc /* The envelope shall supervise the transmit rate of each actuation message ID (0x2E4, 0x343, 0x412, and any other TX-whitelisted ID) against its nominal period and reject frames sent faster than the nominal rate plus a defined tolerance; persistent excess while authority is granted shall revoke authority and be reported. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "TMO";
        :>> timing = "per frame; revoke ≤ 0.1 s after the first rejected frame (DN-01 (assurance/05-software/design-notes/DN-01-tx-rate-supervision.md) D-6; ≤ 0.2 s from the onset of a flood at 2× the nominal rate)";
        :>> verifMethod = "T-SIL, T-HIL";
    }
    requirement <'TSR-519'> tsr_519 : TechnicalSafetyRequirement {
        doc /* The safety MCU shall have a documented interrupt-priority and execution-timing scheme: priorities assigned explicitly for every enabled interrupt; safety hooks, CAN TX and SoC command dispatch either moved out of interrupt context or bounded by measured WCET; and the worst-case latency of the periodic safety processing (timeouts, heartbeat, watchdog service) shown to meet the TSR-401/407/501 budgets under worst-case interrupt load. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW, P-HW (cfg)";
        :>> asil = "C";
        :>> mechanism = "ISO";
        :>> timing = "analysis; WCET measured on target";
        :>> verifMethod = "A, T-HIL";
    }
    requirement <'TSR-601'> tsr_601 : TechnicalSafetyRequirement {
        doc /* selfdrived shall classify faults as (i) untrusted command or input (loss or staleness of an input to the control law, model failure, CAN error, controls mismatch) → immediate disable, and (ii) trustworthy but degrading (thermal, storage, memory) → soft disable. Actuation on an input that has failed its alive or validity check shall end within ≤ 0.2 s. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (C-sup: TSR-407, TSR-408)";
        :>> mechanism = "FR";
        :>> timing = "≤ 0.2 s";
        :>> verifMethod = "T-SIL, FI";
    }
    requirement <'TSR-602'> tsr_602 : TechnicalSafetyRequirement {
        doc /* controlsd shall check the age of modelV2, longitudinalPlan and carState before use (≤ 2 nominal periods) and shall set latActive/longActive false and raise an event when an input is stale. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (C-sup: TSR-408)";
        :>> mechanism = "TMO";
        :>> timing = "≤ 0.1 s";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-603'> tsr_603 : TechnicalSafetyRequirement {
        doc /* No diagnostic (commIssue, posenet, locationd, modeldLagging) shall be masked while the item is engaged, and the driving model shall not be switched while engaged. In the reference configuration the external big model (E-06) shall be absent and not loadable. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (C-sup)";
        :>> mechanism = "DES";
        :>> timing = "—";
        :>> verifMethod = "R, T-SIL";
    }
    requirement <'TSR-604'> tsr_604 : TechnicalSafetyRequirement {
        doc /* Non-finite actuator commands shall be treated as a fault with immediate disable, not replaced silently. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (C-sup)";
        :>> mechanism = "FR";
        :>> timing = "≤ 1 frame";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-605'> tsr_605 : TechnicalSafetyRequirement {
        doc /* The SoC controller shall command with margin below every envelope limit: steering torque ≤ 90 % of τ_max(v), acceleration within [a_min + 0.2, a_max − 0.2] m/s² (proposed), lateral acceleration ≤ 3.0 m/s², lateral jerk ≤ 5 m/s³. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM";
        :>> mechanism = "LIM";
        :>> timing = "per frame";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-606'> tsr_606 : TechnicalSafetyRequirement {
        doc /* On every fault-induced transition to L2/L3 (FSC §12) the SoC shall give a visual and acoustic take-over request within ≤ 1 s of detection, with text that names the actual fault class. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC (HMI)";
        :>> asil = "QM (C-sup: TSR-516)";
        :>> mechanism = "WRN";
        :>> timing = "≤ 1 s";
        :>> verifMethod = "T-HIL, T-VEH";
    }
    requirement <'TSR-607'> tsr_607 : TechnicalSafetyRequirement {
        doc /* The SoC shall warn the driver when the EPS reports LKA unavailable or faulted (complements TSR-110). (a) Outside the cases of (b) the warning is the take-over request (soft disable, visual and acoustic). (b) When the fault starts within 1.5 s of a driver steering override, or at standstill, the SoC may first give the lighter prompt (small alert with chime); if the fault is still present 1.5 s after it started, the SoC shall escalate to the take-over request of (a). The lighter prompt shall not be held for the duration of the fault. (Decided 2026-10-16, register DQ-342, A; System FMEA SFM-ACT-023.) (c) When the fault starts while the driver is steering and lasts more than 1.5 s while they keep steering, the SoC shall give at least the lighter prompt, so that the driver learns of the lost assistance before releasing the wheel; on release the take-over request of (a) follows at once. (Decided by the lead in chat on 2026-10-17, register DQ-366, A; impact record OI-2.) */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (C-sup: TSR-110)";
        :>> mechanism = "WRN";
        :>> timing = "(a) ≤ 1 s; (b) prompt ≤ 1 s, take-over request ≤ 1.5 s after fault onset (the driver has hands on the wheel within the window)";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-608'> tsr_608 : TechnicalSafetyRequirement {
        doc /* Driver monitoring shall escalate warnings for an inattentive driver with the timing set in WP-C-08 §5 (baseline vision 5/8/13 s, wheel-touch 5/15/25 s). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "A (SG-08; allocated to the QM SoC, open: WP-C-04 OI-11)";
        :>> mechanism = "WRN";
        :>> timing = "per policy";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-609'> tsr_609 : TechnicalSafetyRequirement {
        doc /* The DM chain shall mark its output invalid when the cabin image or model output is missing or not credible, and an invalid DM output for > 2 s while engaged shall escalate to a take-over request. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "A (SG-08; allocated to the QM SoC, open: WP-C-04 OI-11)";
        :>> mechanism = "PLB";
        :>> timing = "≤ 2 s";
        :>> verifMethod = "T-SIL, FI";
    }
    requirement <'TSR-610'> tsr_610 : TechnicalSafetyRequirement {
        doc /* DM demo mode (IsDriverViewEnabled) shall not be active while the item can engage. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "A (SG-08; allocated to the QM SoC, open: WP-C-04 OI-11)";
        :>> mechanism = "CFG";
        :>> timing = "—";
        :>> verifMethod = "R, T-SIL";
    }
    requirement <'TSR-611'> tsr_611 : TechnicalSafetyRequirement {
        doc /* If the driver does not respond to the highest DM warning, the SoC shall decelerate, disengage and lock out re-engagement for 1/5/15/30 min. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "A (SG-08; allocated to the QM SoC, open: WP-C-04 OI-11)";
        :>> mechanism = "FR";
        :>> timing = "per policy";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-612'> tsr_612 : TechnicalSafetyRequirement {
        doc /* The wheel-touch fallback shall reset awareness only on a deliberate driver input above a defined threshold, not on any steering or gas input. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "A (SG-08; allocated to the QM SoC, open: WP-C-04 OI-11)";
        :>> mechanism = "PLB";
        :>> timing = "—";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-613'> tsr_613 : TechnicalSafetyRequirement {
        doc /* Debug, joystick and maneuver modes, and the lateralManeuverPlan path to the actuator, shall be absent from reference-configuration builds. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (C-sup); A where it keeps DM active (FSR-02.08, WP-C-04 OI-11)";
        :>> mechanism = "CFG";
        :>> timing = "—";
        :>> verifMethod = "R";
    }
    requirement <'TSR-614'> tsr_614 : TechnicalSafetyRequirement {
        doc /* pandad shall not forward sendcan messages older than 2 control periods (20 ms). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (C-sup: TSR-411)";
        :>> mechanism = "TMO";
        :>> timing = "20 ms";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-615'> tsr_615 : TechnicalSafetyRequirement {
        doc /* The SoC shall immediately disable on any panda fault flag, heartbeat-lost flag, rising safetyTxBlocked count while engaged, or SPI error burst reported in pandaStates. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (C-sup: TSR-502, TSR-108)";
        :>> mechanism = "FR";
        :>> timing = "≤ 0.2 s";
        :>> verifMethod = "T-SIL, FI";
    }
    requirement <'TSR-616'> tsr_616 : TechnicalSafetyRequirement {
        doc /* Driving-model outputs shall be checked for non-finite values, range plausibility and age before use, per AIR-16, AIR-17 and AIR-25 of WP-C-11 (assurance/02-concept/WP-C-11-ai-system-definition-and-safety-requirements.md). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM";
        :>> mechanism = "PLB";
        :>> timing = "per frame";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-617'> tsr_617 : TechnicalSafetyRequirement {
        doc /* Excessive-actuation detection (longitudinal outside 2× ACCEL_MIN/MAX, lateral > 2× ISO lateral acceleration for > 0.25 s) shall be kept and shall latch until cleared offroad. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM";
        :>> mechanism = "PLB";
        :>> timing = "0.25 s";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-618'> tsr_618 : TechnicalSafetyRequirement {
        doc /* A PCM-reported ACC fault shall cause immediate disable with a take-over request. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (C-sup)";
        :>> mechanism = "FR";
        :>> timing = "≤ 0.2 s";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-619'> tsr_619 : TechnicalSafetyRequirement {
        doc /* pandad shall compare the panda-reported safety model, safety parameter and alternative experience with the release-record values and shall prevent engagement and raise an alert on mismatch (refines CSR-016 of WP-S-07 (assurance/03-system/WP-S-07-cybersecurity-requirements-architecture.md)). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (C-sup: TSR-512)";
        :>> mechanism = "PLB";
        :>> timing = "before engagement; ≤ 1 s";
        :>> verifMethod = "T-SIL, T-HIL";
    }
    requirement <'TSR-620'> tsr_620 : TechnicalSafetyRequirement {
        doc /* The item shall not request the TOYOTA safety mode or allow engagement unless the ECU firmware versions read at start-up (EPS, engine, ABS, radar, camera) match the release record of the reference configuration; an unverified or mismatching firmware set shall keep the safety MCU in NOOUTPUT and inform the driver. The envelope cannot read ECU firmware itself, so the refusal rests on the SoC query plus the mode lock of TSR-512. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (C-sup: TSR-512, TSR-803)";
        :>> mechanism = "CFG";
        :>> timing = "at start-up";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-621'> tsr_621 : TechnicalSafetyRequirement {
        doc /* While engaged, selfdrived shall raise an immediate disable with a take-over request when any panda in a car safety mode reports controlsAllowed false, after at most 2 consecutive mismatched samples to absorb transport skew between the CAN and pandaStates sockets, and in any case within ≤ 0.5 s of the first mismatched sample. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (C-sup: TSR-108, TSR-516)";
        :>> mechanism = "PLB";
        :>> timing = "≤ 0.5 s / ≤ 0.5 s to warning";
        :>> verifMethod = "T-SIL, FI";
    }
    requirement <'TSR-622'> tsr_622 : TechnicalSafetyRequirement {
        doc /* While the item can engage, the SoC shall supervise the liveness of the HMI path (UI render loop and sound output stream, each with a heartbeat) and treat a missing heartbeat for > 1 s as a fault: immediate disable, with the take-over request carried by the panda siren (TSR-516) and the cluster cruise state (TSR-309, FSR-05.05). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC (HMI)";
        :>> asil = "QM (C-sup: TSR-516)";
        :>> mechanism = "TMO";
        :>> timing = "≤ 1 s / ≤ 0.2 s";
        :>> verifMethod = "T-SIL, FI";
    }
    requirement <'TSR-623'> tsr_623 : TechnicalSafetyRequirement {
        doc /* Alert sound output shall not be muted or set below a defined audible minimum while the item can engage; if the minimum cannot be guaranteed, engagement shall be prevented with a no-entry alert. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC (HMI)";
        :>> asil = "QM (C-sup: TSR-516)";
        :>> mechanism = "CFG";
        :>> timing = "—";
        :>> verifMethod = "R, T-SIL";
    }
    requirement <'TSR-624'> tsr_624 : TechnicalSafetyRequirement {
        doc /* The SoC shall command deceleration that is not caused by traffic (driver-monitoring no-response, fault-induced force deceleration) only after a visual and acoustic alert announcing it has been given, and shall ramp the request within the envelope bounds a_min (TSR-202) and j_down (TSR-205). The 1 s lead time applies to the driver-monitoring no-response deceleration; a fault soft-disable deceleration may start on the first frame of its alert (DQ-407 A). Rationale: that slow-down is gentle (at most −1.2 m/s² over the 3 s before control is handed back, about 13 km/h at most), its alert sounds from the first frame, and holding it back 1 s means driving on at speed with the fault still active; the plant search found no contact in any order of alert and slow-down (synthetic, no credit). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (B-sup: TSR-202, TSR-205)";
        :>> mechanism = "WRN";
        :>> timing = "Driver-monitoring stop: alert ≥ 1 s before decel onset (proposed); fault soft disable: alert from the first frame of the decel (DQ-407 A)";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-625'> tsr_625 : TechnicalSafetyRequirement {
        doc /* Forward collision warnings shall be raised only from fresh and valid inputs (modelV2 and longitudinalPlan within 2 nominal periods, validity flags set), and the false-FCW rate per driving hour in the ODD shall meet a target set in WP-V-02 (assurance/06-validation/WP-V-02-sotif-vv-strategy.md). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "A (until re-rated: DQ-052 A, WP-C-04 OI-9; allocated to the QM SoC)";
        :>> mechanism = "PLB";
        :>> timing = "≤ 2 periods";
        :>> verifMethod = "T-SIL, LOG";
    }
    requirement <'TSR-626'> tsr_626 : TechnicalSafetyRequirement {
        doc /* While engaged, the SoC shall detect that the envelope does not actuate from evidence other than the envelope's own status report: (a) pandaStates older than 2 nominal periods (0.2 s) is treated as a controls mismatch (TSR-621); (b) with lateral control active, the EPS-applied torque (STEER_TORQUE_EPS in 0x260) not following a commanded torque above a threshold for longer than t_blk; (c) with longitudinal control active, the measured acceleration not following the requested acceleration beyond a tolerance for longer than t_blk. (d) with lateral control active, EPS_STATUS (0x262) LKA_STATE not reporting LKA active, or with longitudinal control active, the PCM not reporting ACC in control, for longer than t_blk; (e) the transmitted-frame count of TSR-632 not advancing for a commanded actuation ID. Each leads to immediate disable with a take-over request, so that the warning falls within the SG-02/SG-06 1 s budget (SFM-ACT-018). Threshold, tolerance and t_blk (≤ 0.5 s) shall be set from fork-owned drive logs so that no false detection occurs in the reference log set. (b) and (c) target envelope blocking; an EPS or PCM that silently stops acting on the item's requests is covered by AOU-17 instead, verified with forced faults (decided 2026-10-18, DQ-360 A); if that test finds a silent drop, (b) and (c) are extended to it. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (C-sup: TSR-516)";
        :>> mechanism = "PLB";
        :>> timing = "(a) 0.2 s; (b), (c) ≤ t_blk ≤ 0.5 s";
        :>> verifMethod = "LOG, T-SIL, FI";
    }
    requirement <'TSR-627'> tsr_627 : TechnicalSafetyRequirement {
        doc /* The alert sound path (soundd) shall run with a real-time scheduling priority not lower than that of ui, or a worst-case load test (maximum logging, encoding and upload) shall show that alert sound output starts within the TSR-606 budget. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC (HMI)";
        :>> asil = "QM (C-sup: TSR-516)";
        :>> mechanism = "TMO";
        :>> timing = "within TSR-606";
        :>> verifMethod = "T-SIL (load), T-HIL";
    }
    requirement <'TSR-628'> tsr_628 : TechnicalSafetyRequirement {
        doc /* While the envelope reports a driver override on the LKA path (TSR-304(b)), the SoC shall show an override cue on the device display within ≤ 0.2 s, so the driver sees that the steering backed off and why. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM";
        :>> mechanism = "WRN";
        :>> timing = "≤ 0.2 s";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-629'> tsr_629 : TechnicalSafetyRequirement {
        doc /* At start-up, before the first engagement of each ignition cycle, the SoC shall read the stored diagnostic trouble codes (DTCs) of the EPS and of the brake / stability control (ABS/VSC) ECU, and shall prevent engagement with a no-entry alert naming the system while either ECU reports an active code. (a) The read shall run only while the item cannot be engaged (before the car safety mode is requested) and only after the vehicle has been seen stationary; it shall never run while the vehicle moves or the item is engaged. (b) A code is active when its status shows test failed, test failed this operation cycle, confirmed, or warning indicator requested (ISO 14229-1 status bits 0, 1, 3, 7), counting only the bits the ECU reports as supported. Pending or history bits alone do not count. A code the release record exempts as not affecting lateral or longitudinal control does not count; none is exempt in the first release, and an exemption needs an impact analysis. (c) A read that was not made (vehicle not seen stationary), not answered completely within the read time, answered with a negative response or malformed, or that reports none of the active bits as supported, shall also prevent engagement, with its own no-entry alert, until the next start-up. (d) The result is an entry condition only: it does not disengage an engaged item. The driver's lamp check (WP-O-02 OPS-01) stays as a second barrier. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (supports TSR-110, TSR-618)";
        :>> mechanism = "PLB, ST";
        :>> timing = "before engagement";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-630'> tsr_630 : TechnicalSafetyRequirement {
        doc /* While a car safety mode is active and the item is not engaged, the SoC shall check that every panda reports controlsAllowed false. A report of true for more than 2 consecutive pandaStates samples, and in any case within ≤ 0.3 s, shall prevent engagement with a no-entry alert, be logged as an envelope fault, and request ACC cancel. (The reverse of TSR-621: it makes a latent panda authority fault visible before the host also commands torque.) */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (C-sup: TSR-105, TSR-301)";
        :>> mechanism = "PLB";
        :>> timing = "≤ 0.3 s (within the SG-01 0.5 s FTTI)";
        :>> verifMethod = "T-SIL, FI";
    }
    requirement <'TSR-631'> tsr_631 : TechnicalSafetyRequirement {
        doc /* controlsd shall treat the driving-model output as stale, with the TSR-602 reaction, when (a) its frame ID does not advance for more than 2 nominal periods while messages keep arriving (frozen output), or (b) its age measured from the source camera frame timestamp, not the publish time, exceeds 2 nominal periods (stale content with fresh timestamps). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (C-sup: TSR-101, TSR-103 bound the effect; TSR-408 covers a stopped command stream)";
        :>> mechanism = "TMO, PLB";
        :>> timing = "≤ 0.1 s";
        :>> verifMethod = "T-SIL, FI";
    }
    requirement <'TSR-632'> tsr_632 : TechnicalSafetyRequirement {
        doc /* The safety MCU shall report to the SoC, for each supervised actuation ID (0x2E4, 0x343), the count of frames accepted by the envelope and transmitted on the car-side bus (transmit complete) and the count refused, in every health report. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C (report content); QM for its use (TSR-626(e))";
        :>> mechanism = "PLB";
        :>> timing = "per health report (≤ 0.1 s)";
        :>> verifMethod = "T-SIL, T-HIL";
    }
    requirement <'TSR-633'> tsr_633 : TechnicalSafetyRequirement {
        doc /* When driver awareness has reached zero (terminal DM alert) and the driver has not responded for 5 s, the item shall keep the lane and decelerate in lane to a standstill within a_min and j_down (TSR-202, TSR-205) with the terminal alert sounding, then keep the vehicle stopped and held, and lock out re-engagement and resumption until the driver responds, so that the item cannot drive off again (register DQ-365, A, decided 2026-10-16). It shall not leave lateral and longitudinal control active at the set speed. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "A (SG-08; allocated to the QM SoC, open: WP-C-04 OI-11)";
        :>> mechanism = "FR, WRN";
        :>> timing = "reaction starts ≤ 5 s after the terminal alert (WP-S-04 §3.8)";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-634'> tsr_634 : TechnicalSafetyRequirement {
        doc /* When driver monitoring has fallen back to the wheel-touch policy (camera confidence too low), the escalation times of TSR-608 shall shorten as vehicle speed rises, so that the distance driven without driver supervision up to each alert stays within a bound set in WP-C-08 §5.4; at highway speed the time to the strongest alert shall be shorter than the fixed 25 s (register DQ-077, A, decided 2026-10-14). The speed table and the bound are set in WP-C-08 §5.4 (DMP-05) and validated under WP-V-02. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "A (SG-08; allocated to the QM SoC, open: WP-C-04 OI-11)";
        :>> mechanism = "WRN";
        :>> timing = "alert k at T_k = 5/15/25 s or D_k = 150/240/395 m since the last driver input, whichever comes first (WP-C-08 §5.4)";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-635'> tsr_635 : TechnicalSafetyRequirement {
        doc /* The time from the driver's change of state (eyes off the road, or hands off under the wheel-touch policy) to the first driver alert shall be ≤ 6 s end to end, including camera frame time, DM model latency and policy evaluation, so the first-alert timer of TSR-608 and TSR-634 shall leave a stated budget for that latency; the no-response reaction of TSR-611 shall start within the time set in WP-S-04 (assurance/03-system/WP-S-04-timing-ftti-budget.md). */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "A (SG-08; allocated to the QM SoC, open: WP-C-04 OI-11)";
        :>> mechanism = "WRN";
        :>> timing = "first alert ≤ 6 s end to end";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-701'> tsr_701 : TechnicalSafetyRequirement {
        doc /* The harness orientation (normal, flipped, not connected) shall be detected before the relay is driven, and CAN routing and relay/ignition pin assignment shall follow it; loss or change of orientation while the relay is driven shall lead to SS-S. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-HW, HAR, P-SW";
        :>> asil = "B";
        :>> mechanism = "PLB";
        :>> timing = "≤ 1 s";
        :>> verifMethod = "T-HIL, FI";
    }
    requirement <'TSR-702'> tsr_702 : TechnicalSafetyRequirement {
        doc /* With the relay de-energised, the harness shall connect the forward camera to the vehicle CAN without any active component in the path. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "HAR";
        :>> asil = "B";
        :>> mechanism = "DES";
        :>> timing = "continuous";
        :>> verifMethod = "A, T-HIL";
    }
    requirement <'TSR-703'> tsr_703 : TechnicalSafetyRequirement {
        doc /* Harness connectors shall be keyed and latched so that partial insertion is detected (not-connected status) or cannot occur. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "HAR";
        :>> asil = "B";
        :>> mechanism = "DES";
        :>> timing = "—";
        :>> verifMethod = "A, R";
    }
    requirement <'TSR-704'> tsr_704 : TechnicalSafetyRequirement {
        doc /* The envelope shall forward every camera-side frame to the car side unchanged, except STEERING_LKA 0x2E4, STEERING_LTA 0x191, LKAS_HUD 0x412 and (openpilot longitudinal) ACC_CONTROL 0x343, and shall forward every car-side frame to the camera side. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "B";
        :>> mechanism = "DES";
        :>> timing = "continuous";
        :>> verifMethod = "T-SIL, T-HIL";
    }
    requirement <'TSR-705'> tsr_705 : TechnicalSafetyRequirement {
        doc /* In the reference configuration the envelope shall not accept from the SoC any frame on the car-side bus that the stock PCS function uses or that only a DSU would send: PRE_COLLISION 0x283, PRE_COLLISION_2 0x344, PCS_HUD 0x411, and the DSU messages 0x2E6, 0x2E7, 0x33E, 0x365, 0x366, 0x4CB and the bus-1 DSU set; if any is kept for a documented reason, its content shall be restricted to the inactive value. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "B";
        :>> mechanism = "GATE";
        :>> timing = "per frame";
        :>> verifMethod = "R, T-SIL";
    }
    requirement <'TSR-706'> tsr_706 : TechnicalSafetyRequirement {
        doc /* On SS-S, any MCU fault, MCU reset, loss of device power or harness supply, the relay shall return to the stock camera-to-vehicle connection. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "HAR, P-HW, P-SW";
        :>> asil = "B";
        :>> mechanism = "FR";
        :>> timing = "≤ 0.1 s after fault reaction";
        :>> verifMethod = "A, T-HIL, FI";
    }
    requirement <'TSR-707'> tsr_707 : TechnicalSafetyRequirement {
        doc /* Forwarded camera-side frames shall be delivered to the car side without loss and with a latency ≤ 1 ms (TBD from the PCS timing analysis) under worst-case bus and SPI load; forwarding queue overflow shall be detected and reported. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "B";
        :>> mechanism = "TMO, PLB";
        :>> timing = "continuous";
        :>> verifMethod = "A, T-HIL";
    }
    requirement <'TSR-708'> tsr_708 : TechnicalSafetyRequirement {
        doc /* PCS/AEB braking shall have priority over 0x343 requests in the PCM, and PCS shall work with the harness installed. (External measure.) */
        :>> workProduct = "WP-S-02";
        :>> allocText = "EXT";
        :>> asil = "ext";
        :>> mechanism = "EXTM";
        :>> timing = "—";
        :>> verifMethod = "T-VEH";
    }
    requirement <'TSR-709'> tsr_709 : TechnicalSafetyRequirement {
        doc /* The SoC shall inform the driver when the stock system reports an AEB or FCW event. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM";
        :>> mechanism = "WRN";
        :>> timing = "≤ 0.2 s";
        :>> verifMethod = "T-SIL";
    }
    requirement <'TSR-710'> tsr_710 : TechnicalSafetyRequirement {
        doc /* The envelope shall detect a relay malfunction (any check_relay control message seen on the car side after the relay transition window) and inhibit all actuation TX and forwarding. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "C";
        :>> mechanism = "PLB, FR";
        :>> timing = "detect: first offending frame after ≤ 1–2 s window / same frame";
        :>> verifMethod = "T-SIL, T-HIL";
    }
    requirement <'TSR-711'> tsr_711 : TechnicalSafetyRequirement {
        doc /* While the relay intercepts, the envelope shall supervise forwarding from the camera side to the car side and release the relay (TSR-706) when forwarding has stopped: no camera-side frame received or none forwarded for longer than t_fwd while the camera-side bus was active before, camera-side bus-off or error-passive, or forwarding queue overflow. t_fwd shall be set from the measured camera-side message periods so that detection stays within the SG-07 FDTI of ≤ 0.1 s. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW";
        :>> asil = "B";
        :>> mechanism = "TMO, FR";
        :>> timing = "detect ≤ 0.1 s / release ≤ 0.1 s (SG-07, WP-S-04 §3.6)";
        :>> verifMethod = "T-HIL, FI";
    }
    requirement <'TSR-712'> tsr_712 : TechnicalSafetyRequirement {
        doc /* If the harness state readback (TSR-506) shows that the camera path stays intercepted when the release is commanded, the envelope shall inhibit all actuation TX, keep the fault latched until power cycle and report it; the SoC shall then give a warning that stock PCS/AEB is unavailable and prevent engagement until the harness is repaired. */
        :>> workProduct = "WP-S-02";
        :>> allocText = "P-SW, SoC";
        :>> asil = "B (envelope detection and inhibit); QM (B-sup: TSR-506) for the SoC warning";
        :>> mechanism = "PLB, FR, WRN";
        :>> timing = "detect ≤ 0.3 s (TSR-506) / warn ≤ 1 s";
        :>> verifMethod = "T-HIL, FI";
    }
    requirement <'TSR-713'> tsr_713 : TechnicalSafetyRequirement {
        doc /* While the stock system reports an AEB event (stockAeb), the SoC shall request zero acceleration in ACC_CONTROL 0x343 (no positive acceleration), keep that request for as long as the event is reported, and then return to normal control; the alert of TSR-709 is unchanged. Stock AEB braking keeps its priority in the PCM (TSR-708, AOU-04R), which is still tested. (Decided 2026-10-18, DQ-300 A; SFM-ACT-020.) */
        :>> workProduct = "WP-S-02";
        :>> allocText = "SoC";
        :>> asil = "QM (no ASIL claim; TSR-708 stays the measure)";
        :>> mechanism = "FR";
        :>> timing = "from the first frame that reports the event";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'TSR-801'> tsr_801 : TechnicalSafetyRequirement {
        doc /* Only a released LionDriver baseline shall be installed: the installed openpilot commit, AGNOS version and model artefact hashes shall equal the release record, and the build shall not be dirty. */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "B‡";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "R-SW record, second-person check";
    }
    requirement <'TSR-802'> tsr_802 : TechnicalSafetyRequirement {
        doc /* The panda firmware shall be the release-signed, non-debug build recorded in the release record; its version string and signature shall be compared before first engagement. */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "B‡";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "R-SW";
    }
    requirement <'TSR-803'> tsr_803 : TechnicalSafetyRequirement {
        doc /* Every vehicle ECU firmware version (engine, EPS, ABS, radar, camera) shall equal the reference record before engagement; a mismatch shall put the item in dashcam mode until an impact analysis extends the scope. */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "B‡";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "R-CFG raw FW query output";
    }
    requirement <'TSR-804'> tsr_804 : TechnicalSafetyRequirement {
        doc /* The installed configuration shall show fingerprint TOYOTA_COROLLA_TSS2 (exact, not fuzzy), safety model toyota, safety parameter 73, alternative experience 0, openpilot longitudinal on, both in carParams and in pandaStates. */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "B‡";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "R-CFG";
    }
    requirement <'TSR-805'> tsr_805 : TechnicalSafetyRequirement {
        doc /* Harness seating and the relay intercept/PCS-forwarding function shall be verified at installation: no relay malfunction or CAN errors, intercepted messages absent on the car side, PCS-relevant camera messages present on the car side with LD-SDA disengaged. */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "B";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "R-INS, R-FUN";
    }
    requirement <'TSR-806'> tsr_806 : TechnicalSafetyRequirement {
        doc /* The parameter set shall equal the release record: Experimental Mode per D-08, DisengageOnAccelerator per WP-C-08, debug/maneuver/joystick modes absent, DM demo mode off, SSH off. */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "QM (B-sup)";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "R-SW parameter dump";
    }
    requirement <'TSR-807'> tsr_807 : TechnicalSafetyRequirement {
        doc /* The device shall be mounted within the position tolerance and calibrated within the angle tolerance band derived from the model validation range. */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "QM (SOTIF)";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "R-CAL";
    }
    requirement <'TSR-808'> tsr_808 : TechnicalSafetyRequirement {
        doc /* Vehicle service actions that can invalidate an AoU or the calibration (alignment/steering/suspension, EPS or ECM/ABS replacement or reflash, windscreen, camera or radar work, tyre size, brake repair, collision repair, battery disconnection, scan-tool sessions, aftermarket accessories) shall trigger the re-verification defined for that action before the item is engaged again. */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "B‡";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "R-CAL / R-CFG / R-FUN as listed";
    }
    requirement <'TSR-809'> tsr_809 : TechnicalSafetyRequirement {
        doc /* The reference-configuration check (INS-21…INS-23), PCS-preservation check (INS-27) and harness inspection shall be repeated at least every 6 months and after any service trigger; harness and camera windows inspected monthly. */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "B";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "Maintenance log";
    }
    requirement <'TSR-810'> tsr_810 : TechnicalSafetyRequirement {
        doc /* Only released baselines shall be installed by update; until signed updates exist, automatic updates shall be disabled and updates installed manually, followed by INS-15…INS-23; model-weight changes require SOTIF re-evaluation; envelope changes require the envelope verification evidence; parameters shall be re-checked after each update; a withdrawn release shall be replaced or the item put in dashcam mode. */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "B‡";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "Release record (WP-K-06)";
    }
    requirement <'TSR-811'> tsr_811 : TechnicalSafetyRequirement {
        doc /* Before every drive the driver shall perform the pre-drive checks and shall not engage if a check fails (vehicle warning lamps, VSC on, clean camera area, device seated, DM camera unobstructed, no offroad alert, driver fit). */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "QM (B-sup)";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "Briefing acknowledgement";
    }
    requirement <'TSR-812'> tsr_812 : TechnicalSafetyRequirement {
        doc /* Each driver shall receive the user information and safety warnings before first use and acknowledge them; in the development phase only approved safety drivers shall operate the item. */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "QM (B-sup)";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "R-USR";
    }
    requirement <'TSR-813'> tsr_813 : TechnicalSafetyRequirement {
        doc /* Field monitoring shall collect and analyse drive logs and driver reports of every installed item, including every disengagement caused by a safety mechanism (controlsMismatch, relayMalfunction, RX invalid, heartbeat lost, safetyTxBlocked > 0), and feed problem resolution and the safety case. */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "QM";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "Monitoring reports";
    }
    requirement <'TSR-814'> tsr_814 : TechnicalSafetyRequirement {
        doc /* On removal of the item the stock camera connection shall be restored and stock TSS functions (LTA/LDA, DRCC, PCS) and the absence of DTCs verified; logs needed for field monitoring retrieved; device data, credentials and identity keys wiped or the device kept under LionDriver control with its history recorded. */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "B (stock path); CS (data)";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "Decommissioning record";
    }
    requirement <'TSR-815'> tsr_815 : TechnicalSafetyRequirement {
        doc /* Only devices and harnesses of the approved hardware revision, with clean history, shall be installed; units returned after a field event or decommissioned from another vehicle shall pass refurbishment inspection first. */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "B‡";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "R-DEV";
    }
    requirement <'TSR-816'> tsr_816 : TechnicalSafetyRequirement {
        doc /* Installation shall be done by a trained installer, and the installation record (R-DEV…R-USR) shall be complete and second-person checked before the first engagement and retained per WP-P-04. */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "B‡";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "Record review";
    }
    requirement <'TSR-817'> tsr_817 : TechnicalSafetyRequirement {
        doc /* Item faults shall be handled by replacement, not repair: defective devices or harnesses shall be quarantined, reported and returned; after replacement the full provisioning and configuration steps shall be repeated. */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "B‡";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "Problem report (WP-P-03)";
    }
    requirement <'TSR-818'> tsr_818 : TechnicalSafetyRequirement {
        doc /* At end of support of a release, every user shall be informed with the date after which the release must not be engaged. */
        :>> workProduct = "WP-S-06";
        :>> allocText = "OPS";
        :>> asil = "QM";
        :>> mechanism = "";
        :>> timing = "";
        :>> verifMethod = "Notification record";
    }
    requirement <'SYS-001'> sys_001 : SystemRequirement {
        doc /* While lateral control is active on a straight or curved road inside the ODD, the system shall keep the vehicle near the lane centre. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.modeld, host.controlsd";
        :>> functionId = "F-01";
        :>> reqType = "P";
        :>> target = "Lateral offset from lane centre: p95 ≤ TBD (proposed 0.3 m), p99.9 ≤ TBD (proposed 0.6 m) per stratum";
        :>> verifMethod = "LOG, T-VEH";
    }
    requirement <'SYS-002'> sys_002 : SystemRequirement {
        doc /* The commanded lateral acceleration shall not exceed 3.0 m/s² (roll-compensated) and the lateral jerk shall not exceed 5 m/s³. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.controlsd";
        :>> functionId = "F-01";
        :>> reqType = "C";
        :>> target = "as stated";
        :>> verifMethod = "T-SIL";
    }
    requirement <'SYS-003'> sys_003 : SystemRequirement {
        doc /* The system shall follow curves down to the radius R_ODD = v²/2.5 m/s² at the travel speed without saturating the steering command. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.controlsd, host.selfdrived";
        :>> functionId = "F-01";
        :>> reqType = "P";
        :>> target = "No steerSaturated in curves ≥ R_ODD in ≥ TBD % of passes";
        :>> verifMethod = "T-VEH, LOG";
    }
    requirement <'SYS-004'> sys_004 : SystemRequirement {
        doc /* When the steering command saturates, the system shall warn the driver ("Turn Exceeds Steering Limit"). */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.selfdrived, host.hmi";
        :>> functionId = "F-01";
        :>> reqType = "H";
        :>> target = "Warning within ≤ 1 s of saturation";
        :>> verifMethod = "T-SIL";
    }
    requirement <'SYS-005'> sys_005 : SystemRequirement {
        doc /* An assisted lane change shall start only after the driver activates the turn signal and applies steering torque in the same direction, above 20 mph. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.modeld";
        :>> functionId = "F-01";
        :>> reqType = "F";
        :>> target = "as stated";
        :>> verifMethod = "T-SIL";
    }
    requirement <'SYS-006'> sys_006 : SystemRequirement {
        doc /* An assisted lane change shall complete or be cancelled within 10 s of the turn signal; it shall be cancelled when the turn signal is released. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.modeld";
        :>> functionId = "F-01";
        :>> reqType = "F";
        :>> target = "10 s";
        :>> verifMethod = "T-SIL";
    }
    requirement <'SYS-007'> sys_007 : SystemRequirement {
        doc /* Lateral control shall not be active at standstill and shall resume without a steering jump when the vehicle moves off. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.controlsd";
        :>> functionId = "F-01";
        :>> reqType = "F";
        :>> target = "Torque change at resume within TSR-103 rate";
        :>> verifMethod = "T-SIL";
    }
    requirement <'SYS-008'> sys_008 : SystemRequirement {
        doc /* Lateral control shall not cause oscillation (weaving) on a straight road. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.controlsd, estimators";
        :>> functionId = "F-01";
        :>> reqType = "P";
        :>> target = "Lateral offset spectral peak 0.2–2 Hz below TBD";
        :>> verifMethod = "LOG, T-VEH";
    }
    requirement <'SYS-020'> sys_020 : SystemRequirement {
        doc /* The system shall hold the set speed within ±TBD km/h on level road without a lead. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.plannerd";
        :>> functionId = "F-02";
        :>> reqType = "P";
        :>> target = "proposed ±2 km/h";
        :>> verifMethod = "T-VEH";
    }
    requirement <'SYS-021'> sys_021 : SystemRequirement {
        doc /* The set-speed range shall be the PCM cruise set range of the reference vehicle, and shall not exceed the ODD speed bound of 110 km/h (ODD-H, DQ-260; the arterial ODD-A was dropped, DQ-023). */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.card";
        :>> functionId = "F-02";
        :>> reqType = "C";
        :>> target = "as stated";
        :>> verifMethod = "R, T-VEH";
    }
    requirement <'SYS-022'> sys_022 : SystemRequirement {
        doc /* When following a lead, the system shall keep a time gap equal to the selected personality: relaxed 1.75 s, standard 1.45 s, aggressive 1.25 s. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.plannerd";
        :>> functionId = "F-02";
        :>> reqType = "P";
        :>> target = "steady-state gap error ≤ TBD";
        :>> verifMethod = "T-VEH, LOG";
    }
    requirement <'SYS-023'> sys_023 : SystemRequirement {
        doc /* The default personality in the reference configuration shall be "standard" or "relaxed", not "aggressive". */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.manager";
        :>> functionId = "F-02";
        :>> reqType = "C";
        :>> target = "as stated";
        :>> verifMethod = "R";
    }
    requirement <'SYS-024'> sys_024 : SystemRequirement {
        doc /* The system shall bring the vehicle to a stop behind a stopping lead, keeping a stopped distance of about 6 m, and hold it at standstill. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.plannerd, host.card";
        :>> functionId = "F-02";
        :>> reqType = "F/P";
        :>> target = "stop distance 6 m ± TBD";
        :>> verifMethod = "T-VEH";
    }
    requirement <'SYS-025'> sys_025 : SystemRequirement {
        doc /* After a standstill, the system shall resume automatically when the lead moves off, within TBD s; without a lead, it shall not move off without a driver action. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.card";
        :>> functionId = "F-02";
        :>> reqType = "F";
        :>> target = "as stated";
        :>> verifMethod = "T-VEH";
    }
    requirement <'SYS-026'> sys_026 : SystemRequirement {
        doc /* Comfort: in normal following, the commanded acceleration shall stay within the cruise limits (1.6→0.6 m/s² by speed, −1.2 m/s² cruise braking) and use stronger braking only for lead-following, down to −3.5 m/s². */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.plannerd";
        :>> functionId = "F-02";
        :>> reqType = "P";
        :>> target = "as stated";
        :>> verifMethod = "T-SIL";
    }
    requirement <'SYS-027'> sys_027 : SystemRequirement {
        doc /* Experimental Mode (end-to-end longitudinal) shall be disabled and not selectable in the reference configuration until decision D-08 includes it. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.manager, host.hmi";
        :>> functionId = "F-02";
        :>> reqType = "C";
        :>> target = "Param default \"0\", toggle disabled";
        :>> verifMethod = "R, T-SIL";
    }
    requirement <'SYS-040'> sys_040 : SystemRequirement {
        doc /* Engagement shall be possible only through the stock cruise controls and only when no no-entry condition is present. In the reference configuration a setting outside the assured values (assured_config.py: following distance other than relaxed, CA-011; Experimental Mode on; alpha longitudinal; a debug or maneuver mode) is a no-entry condition, with a no-entry alert that names the setting (decided 2026-10-18, DQ-221 A; SWF-067, SWF-ACT-063). */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.selfdrived";
        :>> functionId = "F-03";
        :>> reqType = "F";
        :>> target = "as stated";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'SYS-041'> sys_041 : SystemRequirement {
        doc /* The system shall refuse engagement, with a no-entry alert, below the highway speed floor v_floor, and shall engage from v_floor up to the ODD speed bound. This is the entry check for the highways-only ODD (DQ-023) until road-type data exists (WP-C-07 FM-08). Once engaged, slowing below v_floor (traffic, stop-and-go) does not disengage. (Decided 2026-10-18, DQ-280 A; STPA LS-13.) */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.card";
        :>> functionId = "F-03";
        :>> reqType = "F";
        :>> target = "v_floor = TBD (proposed 60 km/h)";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'SYS-042'> sys_042 : SystemRequirement {
        doc /* A brake press or cancel shall disengage; the accelerator shall override longitudinal control without disengaging (reference setting). */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.selfdrived";
        :>> functionId = "F-03";
        :>> reqType = "F";
        :>> target = "as stated";
        :>> verifMethod = "T-VEH";
    }
    requirement <'SYS-043'> sys_043 : SystemRequirement {
        doc /* After start-up, the system shall be ready to engage within TBD s of ignition on. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.selfdrived, hardwared";
        :>> functionId = "F-03";
        :>> reqType = "P";
        :>> target = "proposed ≤ 30 s";
        :>> verifMethod = "T-VEH";
    }
    requirement <'SYS-060'> sys_060 : SystemRequirement {
        doc /* Above 10 km/h, DM shall warn a visually distracted driver with escalating alerts at 5, 8 and 13 s (vision policy) or 5, 15 and 25 s (wheel-touch policy). */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.dm";
        :>> functionId = "F-04";
        :>> reqType = "H";
        :>> target = "as stated";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'SYS-061'> sys_061 : SystemRequirement {
        doc /* DM classification performance shall meet AIR-07/AIR-08 of WP-C-11. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.dm";
        :>> functionId = "F-04";
        :>> reqType = "P";
        :>> target = "recall ≥ 95 % gaze-off > 2 s; false distraction ≤ 1/h (confirmed, WP-C-08 OI-2)";
        :>> verifMethod = "LOG";
    }
    requirement <'SYS-062'> sys_062 : SystemRequirement {
        doc /* DM shall work in the ODD lighting conditions (day, dusk, night with IR) and with sunglasses, or fall back to the wheel-touch policy. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.dm";
        :>> functionId = "F-04";
        :>> reqType = "P";
        :>> target = "fallback triggered when uncertain; coverage TBD";
        :>> verifMethod = "T-VEH, LOG";
    }
    requirement <'SYS-063'> sys_063 : SystemRequirement {
        doc /* On no response to the highest alert, the system shall slow the vehicle, disengage and lock out re-engagement (1/5/15/30 min). */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.dm, host.controlsd";
        :>> functionId = "F-04";
        :>> reqType = "F";
        :>> target = "as stated";
        :>> verifMethod = "T-SIL, T-VEH";
    }
    requirement <'SYS-080'> sys_080 : SystemRequirement {
        doc /* The engaged/disengaged state shall be shown continuously on the device and through the cluster cruise indicator and LKAS HUD. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.hmi, host.card";
        :>> functionId = "F-05";
        :>> reqType = "H";
        :>> target = "as stated";
        :>> verifMethod = "T-VEH";
    }
    requirement <'SYS-081'> sys_081 : SystemRequirement {
        doc /* An alert shall be displayed and its sound started within ≤ 0.2 s of the event being raised by selfdrived. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "host.selfdrived, host.hmi";
        :>> functionId = "F-05";
        :>> reqType = "P";
        :>> target = "p99 ≤ 0.2 s";
        :>> verifMethod = "T-HIL";
    }
    requirement <'SYS-082'> sys_082 : SystemRequirement {
