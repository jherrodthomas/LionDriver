        :>> functionId = "F-08";
        :>> reqType = "I";
        :>> target = "as stated";
        :>> verifMethod = "T-HIL";
    }
    requirement <'SYS-140'> sys_140 : SystemRequirement {
        doc /* Every drive shall be logged in 60 s segments including CAN, carControl, selfdriveState, pandaStates and model outputs. */
        :>> workProduct = "WP-S-01";
        :>> allocText = "remoteAndLogging";
        :>> functionId = "F-09";
