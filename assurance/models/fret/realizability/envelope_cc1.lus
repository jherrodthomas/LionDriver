node imported envelope_cc1( eps_lka_fault:bool ; eps_status_timeout:bool ; hb_engaged:bool ; hb_loss_detected:bool ; revoke_cause_listed:bool ; not_engaged_ticks:int ; pcm_cruise_active:bool ) returns ( lat_authority:bool ;  cause_reported:bool ;  authority_granted:bool ;  siren_on:bool ;  envelope_revoked:bool  );
(*@contract




var __FTP : bool = true -> false;


 
(* whenever lat_authority & (eps_lka_fault | eps_status_timeout) the envelope shall within 10 ticks satisfy !lat_authority & cause_reported  *)

var FR_110 : bool = H((OT(10, 10, ((lat_authority and (eps_lka_fault or eps_status_timeout)) and not ((not (lat_authority) and cause_reported)))) => OT(9, 0, (ZtoPre(false) or (not (lat_authority) and cause_reported)))));  

 
(* whenever preBool(false, authority_granted) & persisted(29, !hb_engaged) the envelope shall immediately satisfy !authority_granted  *)

var FR_307a : bool = H(((YtoPre(authority_granted) and (HT(29, 0, not (hb_engaged)) and HT(28, 0, YtoPre(true)))) => not (authority_granted)));  

 
(* upon hb_loss_detected & preBool(false, authority_granted) the envelope shall within 50 ticks satisfy siren_on  *)

var FR_516a1 : bool = H((OT(50, 50, (((hb_loss_detected and YtoPre(authority_granted)) and ZtoPre(not ((hb_loss_detected and YtoPre(authority_granted))))) and not (siren_on))) => OT(49, 0, (ZtoPre(false) or siren_on))));  

 
(* upon hb_loss_detected & !preBool(false, authority_granted) & occurred(500, authority_granted) the envelope shall within 500 ticks satisfy siren_on  *)

var FR_516a2 : bool = H((OT(500, 500, ((((hb_loss_detected and not (YtoPre(authority_granted))) and (O(authority_granted) and OT(500, 0, authority_granted))) and ZtoPre(not (((hb_loss_detected and not (YtoPre(authority_granted))) and (O(authority_granted) and OT(500, 0, authority_granted)))))) and not (siren_on))) => OT(499, 0, (ZtoPre(false) or siren_on))));  

 
(* upon envelope_revoked & revoke_cause_listed the envelope shall within 50 ticks satisfy siren_on  *)

var FR_516b : bool = H((OT(50, 50, (((envelope_revoked and revoke_cause_listed) and ZtoPre(not ((envelope_revoked and revoke_cause_listed)))) and not (siren_on))) => OT(49, 0, (ZtoPre(false) or siren_on))));  

 
(* upon persisted(69, eps_lka_fault) & occurred(69, lat_authority) the envelope shall within 30 ticks satisfy siren_on  *)

var FR_516b_eps : bool = H((OT(30, 30, ((((HT(69, 0, eps_lka_fault) and HT(68, 0, YtoPre(true))) and (O(lat_authority) and OT(69, 0, lat_authority))) and ZtoPre(not (((HT(69, 0, eps_lka_fault) and HT(68, 0, YtoPre(true))) and (O(lat_authority) and OT(69, 0, lat_authority)))))) and not (siren_on))) => OT(29, 0, (ZtoPre(false) or siren_on))));  

 
(* upon not_engaged_ticks >= 50 & pcm_cruise_active the envelope shall within 50 ticks satisfy siren_on  *)

var FR_516c : bool = H((OT(50, 50, ((((not_engaged_ticks >= 50) and pcm_cruise_active) and ZtoPre(not (((not_engaged_ticks >= 50) and pcm_cruise_active)))) and not (siren_on))) => OT(49, 0, (ZtoPre(false) or siren_on))));  

 
(* upon siren_on the envelope shall for 299 ticks satisfy siren_on  *)

var FR_516_duration : bool = H((OT(299, 0, (siren_on and ZtoPre(not (siren_on)))) => (H(not (siren_on)) or siren_on)));  


 

 guarantee FR_110;  

 guarantee FR_307a;  

 guarantee FR_516a1;  

 guarantee FR_516a2;  

 guarantee FR_516b;  

 guarantee FR_516b_eps;  

 guarantee FR_516c;  

 guarantee FR_516_duration; 

*)
