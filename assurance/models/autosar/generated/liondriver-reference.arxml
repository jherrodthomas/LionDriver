            </APPLICATION-SW-COMPONENT-TYPE>
            <COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE>
              <SHORT-NAME>PlatformFirmware</SHORT-NAME>
              <LONG-NAME>
                <L-4 L="EN">E-03b Panda platform firmware</L-4>
              </LONG-NAME>
              <DESC>
                <L-2 L="EN">main loop, tick handler, CAN/SPI drivers, comms handlers, harness/relay driver, fault handling, bootstub Bare-metal C (panda board firmware), described as a complex device driver because it owns the SPI, FDCAN, GPIO and audio hardware directly. Units: panda.main, panda.main.safety_task, panda.drivers.heartbeat_monitor, panda.drivers.heartbeat_siren, panda.drivers.eps_fault_siren, panda.drivers.hw_watchdog, panda.drivers.irq_priorities, panda.reference_lock, panda.comms, panda.drivers.spi, panda.drivers.usb, panda.drivers.fdcan, panda.drivers.harness, panda.sys.faults, panda.sys.power_saving, panda.drivers.siren, panda.platform, panda.bootstub</L-2>
              </DESC>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="LionDriver.Source">
                    <SD GID="workProduct">WP-W-03</SD>
                    <SD GID="clause">§3.1</SD>
                    <SD GID="sysmlElement">context.ldsda.safetyFirmware.platformFirmware</SD>
                  </SDG>
                  <SDG GID="LionDriver.Trace">
                    <SD GID="integrity">C</SD>
                  </SDG>
                  <SDG GID="LionDriver.HSI.HSI-01">
                    <SD GID="interface">SoC ↔ MCU SPI link</SD>
                    <SD GID="hardware">SPI4 slave and DMA2 streams into the SRAM1/2 buffers (§3, §8)</SD>
                    <SD GID="software">Check every transfer and bound every length against the MCU buffer (TSR-410, 412); keep the DMA buffers apart from the safety state (TSR-507, HSI-14)</SD>
                    <SD GID="detection">SW: per-transfer checksum and length check</SD>
                    <SD GID="reaction">Transfer refused (NACK) and counted; an error burst while engaged revokes authority (TSR-413)</SD>
                    <SD GID="status">partial</SD>
                    <SD GID="hwOwner">E-04a; E-04b</SD>
                    <SD GID="swOwner">E-03b; host pandad</SD>
                    <SD GID="hwResource">SPI4, DMA2 streams 2/3, SRAM1/2 buffers</SD>
                    <SD GID="autosarAnalogue">Spi driver (MCAL)</SD>
                    <SD GID="tsr">TSR-410</SD>
                    <SD GID="tsr">TSR-412</SD>
                    <SD GID="tsr">TSR-507</SD>
                    <SD GID="tsr">TSR-413</SD>
                  </SDG>
                  <SDG GID="LionDriver.HSI.HSI-02">
                    <SD GID="interface">Control requests over SPI endpoint 0</SD>
                    <SD GID="hardware">Nothing beyond HSI-01: requests arrive on SPI endpoint 0</SD>
                    <SD GID="software">Accept only the requests the mode allows (TSR-512, 513) and supervise the heartbeat (TSR-407, 409)</SD>
                    <SD GID="detection">SW: heartbeat monitor, reference lock</SD>
                    <SD GID="reaction">Authority revoked with the siren (TSR-516); a refused request leaves the state unchanged</SD>
                    <SD GID="status">partial</SD>
                    <SD GID="hwOwner">E-04a</SD>
                    <SD GID="swOwner">E-03b; host pandad</SD>
                    <SD GID="hwResource">—</SD>
                    <SD GID="autosarAnalogue">Com/Dcm-like request handling (no AUTOSAR module)</SD>
                    <SD GID="tsr">TSR-512</SD>
                    <SD GID="tsr">TSR-513</SD>
                    <SD GID="tsr">TSR-407</SD>
                    <SD GID="tsr">TSR-409</SD>
                    <SD GID="tsr">TSR-516</SD>
                  </SDG>
                  <SDG GID="LionDriver.HSI.HSI-03">
                    <SD GID="interface">CAN packet stream over SPI endpoints 1/3</SD>
                    <SD GID="hardware">Nothing beyond HSI-01: CAN packets on SPI endpoints 1 and 3</SD>
                    <SD GID="software">Unpack the stream and pass every actuation frame through the TX hook (TSR-410, 411, 518)</SD>
                    <SD GID="detection">SW: per-packet checksum, TX hook, TX-rate check</SD>
                    <SD GID="reaction">Frame rejected and returned to the SoC; a rate excess revokes authority (TSR-518)</SD>
                    <SD GID="status">partial</SD>
                    <SD GID="hwOwner">E-04a</SD>
                    <SD GID="swOwner">E-03a; E-03b; host pandad</SD>
                    <SD GID="hwResource">SPI4</SD>
                    <SD GID="autosarAnalogue">PduR/CanIf routing</SD>
                    <SD GID="tsr">TSR-410</SD>
                    <SD GID="tsr">TSR-411</SD>
                    <SD GID="tsr">TSR-518</SD>
                  </SDG>
                  <SDG GID="LionDriver.HSI.HSI-04">
                    <SD GID="interface">FDCAN1–3 and transceivers</SD>
                    <SD GID="hardware">FDCAN1–3 controllers with the CAN CRC, error counters and bus-off, and the transceiver enable lines (§5)</SD>
                    <SD GID="software">Check every RX message the envelope uses (TSR-401…406), forward camera frames unchanged (TSR-704, 707), send only through the TX hook and react to bus-off (TSR-508)</SD>
                    <SD GID="detection">HW: CAN CRC and error confinement; SW: RX checks and timeouts</SD>
                    <SD GID="reaction">An RX fault revokes authority; bus-off is counted and the core reset, a safety reaction is required (HWSR-508)</SD>
                    <SD GID="status">partial</SD>
                    <SD GID="hwOwner">E-04a</SD>
                    <SD GID="swOwner">E-03a; E-03b</SD>
                    <SD GID="hwResource">FDCAN, transceiver enable GPIOs</SD>
                    <SD GID="autosarAnalogue">Can driver, CanIf, CanSM (bus-off)</SD>
                    <SD GID="tsr">TSR-401</SD>
                    <SD GID="tsr">TSR-402</SD>
                    <SD GID="tsr">TSR-403</SD>
                    <SD GID="tsr">TSR-404</SD>
                    <SD GID="tsr">TSR-405</SD>
                    <SD GID="tsr">TSR-406</SD>
                    <SD GID="tsr">TSR-704</SD>
                    <SD GID="tsr">TSR-707</SD>
                    <SD GID="tsr">TSR-508</SD>
                  </SDG>
                  <SDG GID="LionDriver.HSI.HSI-05">
                    <SD GID="interface">Harness relay drive</SD>
                    <SD GID="hardware">Open-drain GPIO driving the intercept relay in the harness; released at reset (to be confirmed, AOU-13)</SD>
                    <SD GID="software">Drive the relay only in a car mode with a harness detected, and release it in SILENT, NOOUTPUT and ELM327 and in the safe state (TSR-506, 706)</SD>
                    <SD GID="detection">Not detected: no readback (GAP-12); required by HWSR-506a</SD>
                    <SD GID="reaction">Relay released: the stock camera path is restored (SG-07)</SD>
                    <SD GID="status">partial</SD>
                    <SD GID="hwOwner">E-04a; E-05</SD>
                    <SD GID="swOwner">E-03b</SD>
                    <SD GID="hwResource">GPIO (open-drain, active-low)</SD>
                    <SD GID="autosarAnalogue">Dio driver</SD>
                    <SD GID="tsr">TSR-506</SD>
                    <SD GID="tsr">TSR-706</SD>
                  </SDG>
                  <SDG GID="LionDriver.HSI.HSI-06">
                    <SD GID="interface">Harness orientation sense</SD>
                    <SD GID="hardware">ADC1 channels 4 and 17 on the SBU lines (§6)</SD>
                    <SD GID="software">Detect the orientation while the relay is not driven, map CAN and relay pins to it, and re-initialise on a change (TSR-701)</SD>
                    <SD GID="detection">SW: ADC threshold at 8 Hz</SD>
                    <SD GID="reaction">CAN re-initialised and the safety mode re-applied</SD>
                    <SD GID="status">partial</SD>
                    <SD GID="hwOwner">E-04a; E-05</SD>
                    <SD GID="swOwner">E-03b</SD>
                    <SD GID="hwResource">ADC1 ch4/ch17 on SBU1/SBU2</SD>
                    <SD GID="autosarAnalogue">Adc driver</SD>
                    <SD GID="tsr">TSR-701</SD>
                  </SDG>
                  <SDG GID="LionDriver.HSI.HSI-07">
                    <SD GID="interface">Ignition line</SD>
                    <SD GID="hardware">Digital input on the SBU ignition line</SD>
                    <SD GID="software">Use the line to select the heartbeat timeouts and the power state (TSR-510)</SD>
                    <SD GID="detection">Not detected: no plausibility check of the line (LS-28)</SD>
                    <SD GID="reaction">—</SD>
                    <SD GID="status">partial</SD>
                    <SD GID="hwOwner">E-04a; E-05</SD>
                    <SD GID="swOwner">E-03b</SD>
                    <SD GID="hwResource">SBU GPIO input</SD>
                    <SD GID="autosarAnalogue">EcuM wake-up / Dio</SD>
                    <SD GID="tsr">TSR-510</SD>
                  </SDG>
                  <SDG GID="LionDriver.HSI.HSI-08">
                    <SD GID="interface">Reset / boot pins from SoC</SD>
                    <SD GID="hardware">SoC GPIOs to NRST and BOOT0; ST ROM bootloader on BOOT0 high (§7)</SD>
                    <SD GID="software">Keep the MCU outputs safe during reset and boot (TSR-502, HWSR-502c) and keep flash closed to the ROM bootloader (TSR-511)</SD>
                    <SD GID="detection">SW: reset cause reported in the health packet</SD>
                    <SD GID="reaction">Restart in SILENT with the relay released; RDP and WRP are required (TSR-511)</SD>
                    <SD GID="status">partial</SD>
                    <SD GID="hwOwner">E-04a; E-04b</SD>
                    <SD GID="swOwner">E-03b; host pandad</SD>
                    <SD GID="hwResource">SoC GPIO → MCU NRST, BOOT0</SD>
                    <SD GID="autosarAnalogue">external reset (no AUTOSAR module)</SD>
                    <SD GID="tsr">TSR-502</SD>
                    <SD GID="tsr">TSR-511</SD>
                  </SDG>
                  <SDG GID="LionDriver.HSI.HSI-09">
                    <SD GID="interface">Watchdog</SD>
                    <SD GID="hardware">IWDG1 window watchdog, 90 ms nominal, on its own clock</SD>
                    <SD GID="software">Start it at the first relay drive and service it only after the 100 Hz safety task completes (TSR-501)</SD>
                    <SD GID="detection">HW: watchdog timeout</SD>
                    <SD GID="reaction">MCU reset: relay released, restart in SILENT</SD>
                    <SD GID="status">in place</SD>
                    <SD GID="hwOwner">E-04a</SD>
                    <SD GID="swOwner">E-03b</SD>
                    <SD GID="hwResource">IWDG1 (window mode, 90 ms nominal, started at the first relay energisation; panda 3859fa8), software timestamp check</SD>
                    <SD GID="autosarAnalogue">Wdg driver, WdgIf, WdgM</SD>
                    <SD GID="tsr">TSR-501</SD>
                  </SDG>
                  <SDG GID="LionDriver.HSI.HSI-10">
                    <SD GID="interface">Fault / health monitors</SD>
                    <SD GID="hardware">Fault vectors (NMI, HardFault), clock security system, die temperature sensor, interrupt-rate counters</SD>
                    <SD GID="software">Classify each fault and take the safe state (TSR-502…505, 509); today most are reported only</SD>
                    <SD GID="detection">HW: CSS and fault vectors; SW: counters and register checks</SD>
                    <SD GID="reaction">NMI and HardFault reset the MCU; the other faults are reported only, a reaction is required</SD>
                    <SD GID="status">partial</SD>
                    <SD GID="hwOwner">E-04a</SD>
                    <SD GID="swOwner">E-03b</SD>
                    <SD GID="hwResource">NVIC, RCC CSS, DTS, ADC, interrupt-rate counters</SD>
                    <SD GID="autosarAnalogue">Dem, Det</SD>
                    <SD GID="tsr">TSR-502</SD>
                    <SD GID="tsr">TSR-503</SD>
                    <SD GID="tsr">TSR-504</SD>
                    <SD GID="tsr">TSR-505</SD>
                    <SD GID="tsr">TSR-509</SD>
                  </SDG>
                  <SDG GID="LionDriver.HSI.HSI-11">
                    <SD GID="interface">Siren</SD>
                    <SD GID="hardware">DAC with DMA and an audio codec over I2C5, or an amplifier, to the speaker</SD>
                    <SD GID="software">Sound the siren when authority is revoked or the EPS fault persists (TSR-516), and test it at start-up (TSR-515)</SD>
                    <SD GID="detection">Not detected: no feedback from the speaker; a start-up test is required</SD>
                    <SD GID="reaction">—</SD>
                    <SD GID="status">partial</SD>
                    <SD GID="hwOwner">E-04a; E-04b</SD>
                    <SD GID="swOwner">E-03b</SD>
                    <SD GID="hwResource">DAC/DMA + codec over I2C5 (board-dependent)</SD>
                    <SD GID="autosarAnalogue">Dio, I2c (complex driver)</SD>
                    <SD GID="tsr">TSR-516</SD>
                    <SD GID="tsr">TSR-515</SD>
                  </SDG>
                  <SDG GID="LionDriver.HSI.HSI-12">
                    <SD GID="interface">Flash and bootstub</SD>
                    <SD GID="hardware">Flash bank 1: bootstub in sector 0, application from 0x08020000; RDP and WRP option bytes</SD>
                    <SD GID="software">Verify the application's signature before it runs (TSR-511, 514) and its CRC at start-up and periodically (TSR-503)</SD>
                    <SD GID="detection">SW: signature check at boot</SD>
                    <SD GID="reaction">The bootstub does not start the application and enters the soft flasher</SD>
                    <SD GID="status">partial</SD>
                    <SD GID="hwOwner">E-04a</SD>
                    <SD GID="swOwner">E-03b</SD>
                    <SD GID="hwResource">Flash bank 1, sector 0 bootstub, app at 0x08020000</SD>
                    <SD GID="autosarAnalogue">Fls, bootloader (outside AUTOSAR)</SD>
                    <SD GID="tsr">TSR-511</SD>
                    <SD GID="tsr">TSR-514</SD>
                    <SD GID="tsr">TSR-503</SD>
                  </SDG>
                  <SDG GID="LionDriver.HSI.HSI-13">
                    <SD GID="interface">Supply measurement</SD>
                    <SD GID="hardware">ADC1 with an input divider on the supply; BOR and PVD in the MCU</SD>
                    <SD GID="software">Measure the supply and take the safe state outside the operating range (TSR-505, HWSR-505b)</SD>
                    <SD GID="detection">SW: ADC reading on each health request; BOR and PVD are not configured yet</SD>
                    <SD GID="reaction">Required: safe state outside the range</SD>
                    <SD GID="status">partial</SD>
                    <SD GID="hwOwner">E-04a</SD>
                    <SD GID="swOwner">E-03b</SD>
                    <SD GID="hwResource">ADC1 (input divider)</SD>
                    <SD GID="autosarAnalogue">Adc driver</SD>
                    <SD GID="tsr">TSR-505</SD>
                  </SDG>
                  <SDG GID="LionDriver.HSI.HSI-14">
                    <SD GID="interface">MPU, RAM ECC (to be added)</SD>
                    <SD GID="hardware">Cortex-M7 MPU and RAM ECC (RAMECC)</SD>
                    <SD GID="software">Configure MPU regions so DMA and non-safety code cannot reach the safety state, and handle ECC errors (TSR-503, 507)</SD>
                    <SD GID="detection">HW: MPU fault and ECC error, once configured</SD>
                    <SD GID="reaction">Required: safe state</SD>
                    <SD GID="status">missing</SD>
                    <SD GID="hwOwner">E-04a</SD>
                    <SD GID="swOwner">E-03b</SD>
                    <SD GID="hwResource">Cortex-M7 MPU, RAMECC</SD>
                    <SD GID="autosarAnalogue">Os memory protection, MemIf/ECC</SD>
                    <SD GID="tsr">TSR-503</SD>
                    <SD GID="tsr">TSR-507</SD>
                  </SDG>
                  <SDG GID="LionDriver.HwSignal.S-22">
                    <SD GID="signal">Relay drive (tres PA8 / cuatro PA9; PA3)</SD>
                    <SD GID="direction">MCU → harness relay</SD>
                    <SD GID="hsi">HSI-05, HSI-06, HSI-07, HSI-08, HSI-09, HSI-10, HSI-11, HSI-12, HSI-13, HSI-14</SD>
                    <SD GID="validity">none at the baseline; required contact readback (TSR-506)</SD>
                    <SD GID="asil">B</SD>
                    <SD GID="tsr">TSR-506</SD>
                    <SD GID="tsr">TSR-706</SD>
                    <SD GID="tsr">TSR-710</SD>
                    <SD GID="tsr">TSR-711</SD>
