            <APPLICATION-SW-COMPONENT-TYPE>
              <SHORT-NAME>SafetyLayer</SHORT-NAME>
              <LONG-NAME>
                <L-4 L="EN">E-03a Safety layer</L-4>
              </LONG-NAME>
              <DESC>
                <L-2 L="EN">opendbc safety core + Toyota mode, compiled into the panda firmware Bare-metal C in the panda firmware, not an AUTOSAR SWC. Units: panda.safety.core, panda.safety.core.rx_engagement, panda.safety.core.tx_rate_check, panda.safety.lateral, panda.safety.longitudinal, panda.safety.helpers, panda.safety.toyota, panda.safety.toyota.eps_fault, panda.safety.toyota.ref_rx_set, panda.safety.toyota.cruise_main, panda.safety.toyota.tx_budgets, panda.safety.defaults, panda.safety.ignition, panda.safety.other_modes</L-2>
              </DESC>
              <ADMIN-DATA>
                <SDGS>
                  <SDG GID="LionDriver.Source">
                    <SD GID="workProduct">WP-W-03</SD>
                    <SD GID="clause">§3.1</SD>
                    <SD GID="sysmlElement">context.ldsda.safetyFirmware.safetyLayer</SD>
                  </SDG>
                  <SDG GID="LionDriver.Trace">
                    <SD GID="integrity">C</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <PORTS>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>Rx_BRAKE_MODULE</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">bus 0, RX check and envelope inputs</L-2>
                  </DESC>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/LionDriver/PortInterfaces/If_BRAKE_MODULE</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>Rx_EPS_STATUS</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">bus 0, RX check and envelope inputs</L-2>
                  </DESC>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/LionDriver/PortInterfaces/If_EPS_STATUS</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>Rx_PCM_CRUISE</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">bus 0, RX check and envelope inputs</L-2>
                  </DESC>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/LionDriver/PortInterfaces/If_PCM_CRUISE</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>Rx_PCM_CRUISE_2</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">bus 0, RX check and envelope inputs</L-2>
                  </DESC>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/LionDriver/PortInterfaces/If_PCM_CRUISE_2</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>Rx_STEER_TORQUE_SENSOR</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">bus 0, RX check and envelope inputs</L-2>
                  </DESC>
                  <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/LionDriver/PortInterfaces/If_STEER_TORQUE_SENSOR</REQUIRED-INTERFACE-TREF>
                </R-PORT-PROTOTYPE>
                <R-PORT-PROTOTYPE>
                  <SHORT-NAME>Rx_WHEEL_SPEEDS</SHORT-NAME>
