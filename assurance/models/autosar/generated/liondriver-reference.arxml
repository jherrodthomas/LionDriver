                    <SD GID="hsi">HSI-03</SD>
                    <SD GID="hsi">HSI-04</SD>
                    <SD GID="tsr">TSR-704</SD>
                  </SDG>
                </SDGS>
              </ADMIN-DATA>
              <IS-SERVICE>false</IS-SERVICE>
              <OPERATIONS>
                <CLIENT-SERVER-OPERATION>
                  <SHORT-NAME>RxHook</SHORT-NAME>
                  <DESC>
                    <L-2 L="EN">safety_rx_hook: every received frame; RX checks (checksum, counter, timeout) and the state the envelope keeps</L-2>
                  </DESC>
                  <ARGUMENTS>
                    <ARGUMENT-DATA-PROTOTYPE>
                      <SHORT-NAME>packet</SHORT-NAME>
                      <TYPE-TREF DEST="IMPLEMENTATION-DATA-TYPE">/LionDriver/ImplementationDataTypes/CanPacket</TYPE-TREF>
                      <DIRECTION>IN</DIRECTION>
                    </ARGUMENT-DATA-PROTOTYPE>
