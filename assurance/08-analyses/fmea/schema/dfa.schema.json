{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jherrodthomas/LionDriver/assurance/08-analyses/fmea/schema/dfa.schema.json",
  "title": "LionDriver Dependent Failure Analysis (ISO 26262-9 clause 7)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis", "categories", "decompositions", "dfis", "measures", "open_items"],
  "properties": {
    "schema_version": {"const": 1},
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "revision", "status", "baseline", "fsc_revision", "scope"],
      "properties": {
        "id": {"const": "DFA"},
        "type": {"const": "dfa"},
        "doc_id": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "status": {"enum": ["draft", "in_review", "released"]},
        "baseline": {"type": "string"},
        "fsc_revision": {"type": "string", "description": "FSC revision analyzed; must equal the current FSC revision"},
        "scope": {"type": "string", "minLength": 1},
        "approver": {"type": "string"},
        "team": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["name", "role"],
                    "properties": {"name": {"type": "string"}, "role": {"type": "string"}}}
        },
        "references": {"type": "array", "items": {"type": "string"}},
        "updated": {"type": "string", "format": "date"},
        "history": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": false, "required": ["revision", "date", "author", "change"],
                    "properties": {"revision": {"type": "string"}, "date": {"type": "string", "format": "date"},
                                   "author": {"type": "string"}, "change": {"type": "string"}}}
        }
      }
    },
    "categories": {
      "description": "DFI checklist (ISO 26262-9 clause 7 / ISO 26262-11 4.7). Every category must be covered by a DFI or declared not applicable.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "applicable", "rationale"],
        "properties": {
          "id": {"type": "string", "pattern": "^CAT-[0-9]{2}$"},
          "name": {"type": "string"},
          "applicable": {"type": "boolean"},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "decompositions": {
      "description": "One entry per decomposed FSR in the FSC.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fsr", "channels", "status", "rationale"],
        "properties": {
          "fsr": {"type": "string", "pattern": "^FSR-[0-9]{3,}$"},
          "channels": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": {"type": "object", "additionalProperties": false, "required": ["fsr", "elements"],
                      "properties": {"fsr": {"type": "string", "pattern": "^FSR-[0-9]{3,}$"},
                                     "elements": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(EL|XM)-[0-9]{2,}$"}}}}
          },
          "status": {"enum": ["accepted", "conditional", "not_accepted", "not_assessable"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "dfis": {
      "description": "Dependent failure initiators.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "kind", "description", "decompositions", "effect", "measures", "assessment", "rationale"],
        "properties": {
          "id": {"type": "string", "pattern": "^DFI-[0-9]{2,}$"},
          "category": {"type": "string", "pattern": "^CAT-[0-9]{2}$"},
          "kind": {"enum": ["common_cause", "cascading"]},
          "description": {"type": "string", "minLength": 1},
          "decompositions": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^FSR-[0-9]{3,}$"}},
          "effect": {"type": "string", "minLength": 1, "description": "How both channels are defeated, or why the result is still safe"},
          "evidence": {"type": "string", "description": "Code or document reference for the coupling"},
          "measures": {"type": "array", "items": {"type": "string", "pattern": "^DM-[0-9]{2,}$"}},
          "assessment": {"enum": ["sufficient", "insufficient", "open", "safe_by_design"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "measures": {
      "description": "Measures against dependent failures: existing ones and ones still required.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^DM-[0-9]{2,}$"},
          "description": {"type": "string", "minLength": 1},
          "status": {"enum": ["existing", "existing_unverified", "required"]},
          "ref": {"type": "string"},
          "allocated_to": {"type": "array", "items": {"type": "string", "pattern": "^(EL|XM)-[0-9]{2,}$|^process$"}}
        }
      }
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "affects", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^DOI-[0-9]{3,}$"},
          "text": {"type": "string", "minLength": 1},
          "affects": {"type": "array", "items": {"type": "string", "pattern": "^(DFI|DM|FSR|EL)-[0-9]{2,}$"}},
          "status": {"enum": ["open", "closed"]},
          "resolution": {"type": "string"}
        }
      }
    }
  }
}
