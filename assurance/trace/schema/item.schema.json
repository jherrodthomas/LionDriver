{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jherrodthomas/LionDriver/assurance/trace/schema/item.schema.json",
  "title": "LionDriver trace item (WP-P-06 §5.1, trace README §4)",
  "description": "One item of assurance/trace/items/*.yaml. Required fields per kind follow check_trace.py REQUIRED; check_schema.py validates every item with the pinned jsonschema (DQ-123 A).",
  "type": "object",
  "required": [
    "id",
    "kind",
    "status",
    "source"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^((H|HE|HS|SG|FSR|TSR|SWSR|HWSR|SH|TC|FI|FM|SOTIF|AIR|DSR|MLR|MON|KS|DVR|DEV|TS|CSG|CSR|SYS|AOU|IFR)-[0-9]{2,3}(\\.[0-9]{1,2})?[a-z]?|VS-[A-Z]{2,4}-[0-9]{2,3}[a-z]?)$"
    },
    "kind": {
      "enum": [
        "ai-requirement",
        "aou",
        "cybersecurity-goal",
        "cybersecurity-requirement",
        "dataset-requirement",
        "fsr",
        "functional-insufficiency",
        "functional-modification",
        "hazard",
        "hazardous-event",
        "hwsr",
        "interface-requirement",
        "safety-goal",
        "sotif-hazard",
        "swsr",
        "system-requirement",
        "threat-scenario",
        "triggering-condition",
        "tsr"
      ]
    },
    "status": {
      "enum": [
        "agreed",
        "implemented",
        "proposed",
        "verified",
        "withdrawn"
      ]
    },
    "source": {
      "type": "string",
      "pattern": "^WP-[A-Z]-[0-9]{2}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "situation": {
      "type": "string",
      "minLength": 1
    },
    "effect": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "safe_state": {
      "type": "string",
      "minLength": 1
    },
    "ftti_text": {
      "type": "string",
      "minLength": 1
    },
    "credited_in": {
      "type": "string",
      "minLength": 1
    },
    "verification_approach": {
      "type": "string",
      "minLength": 1
    },
    "aou_status": {
      "type": "string",
      "minLength": 1
    },
    "allocated_to": {
      "type": "string",
      "minLength": 1
    },
    "verification": {
      "type": "string",
      "minLength": 1
    },
    "baseline_impl": {
      "type": "string",
      "minLength": 1
    },
    "parent_text": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "string",
      "minLength": 1
    },
    "applies_to": {
      "type": "string",
      "minLength": 1
    },
    "proposed_by": {
      "type": "string",
      "minLength": 1
    },
    "mechanism": {
      "type": "string",
      "description": "May be empty: the WP-S-02 §10 table (TSR-8xx) has no such column"
    },
    "timing": {
      "type": "string",
      "description": "May be empty: the WP-S-02 §10 table (TSR-8xx) has no such column"
    },
    "hw_kind": {
      "type": "string",
      "minLength": 1
    },
    "sg_exempt_reason": {
      "type": "string",
      "minLength": 1
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F-[0-9]{2}$"
      }
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "aou_dependency": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "e": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "c": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "asil": {
      "type": "string",
      "minLength": 1
    },
    "asil_if_aou_fails": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "QM",
            "A",
            "B",
            "C",
            "D"
          ]
        }
      ]
    },
    "aou_flag": {
      "type": "boolean"
    },
    "other_parents": {
      "type": "boolean"
    },
    "ftti_ms": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "function_text": {
      "type": "string",
      "minLength": 1
    },
    "linked_text": {
      "type": "string",
      "minLength": 1
    },
    "situations": {
      "type": "string",
      "minLength": 1
    },
    "fi_type": {
      "enum": [
        "P",
        "S"
      ],
      "description": "WP-C-06 §3: P performance limitation, S specification insufficiency"
    },
    "component": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "evaluation": {
      "type": "string",
      "minLength": 1
    },
    "gap_text": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "enum": [
        "P1",
        "P2",
        "P3"
      ]
    },
    "shares_event": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "insufficiencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "addresses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "related_tsr": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TSR-[0-9]{3}[a-z]?$"
      }
    },
    "stride": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "string",
      "minLength": 1
    },
    "violated_property": {
      "type": "string",
      "minLength": 1
    },
    "damage_text": {
      "type": "string",
      "minLength": 1
    },
    "treatment": {
      "type": "string",
      "minLength": 1
    },
    "concept_requirement": {
      "type": "string",
      "pattern": "^CSR-C-[0-9]{2}$"
    },
    "cal": {
      "type": "string",
      "minLength": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "safety_relation": {
      "type": "string",
      "minLength": 1
    },
    "risk": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "protects": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SG-[0-9]{2}$"
      }
    },
    "criterion": {
      "type": "string",
      "minLength": 1
    },
    "related_text": {
      "type": "string",
      "minLength": 1
    },
    "tbd_rationale": {
      "type": "string",
      "minLength": 1
    },
    "related_items": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(SH|AIR)-[0-9]{2}$"
      }
    },
    "interface": {
      "type": "string",
      "pattern": "^IX-[0-9]{2}$",
      "description": "The process-model interface (assurance/process/model/interfaces.yaml) the item stands for"
    },
    "owners": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "The two roles (WP-M-02 §3.1) whose lanes the interface joins, in the order of the interface's work products"
    },
    "open_item": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "review_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^REV-[0-9]{3}$"
        }
      ],
      "description": "Review record in assurance/case-records/reviews/reviews.yaml"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ai-requirement"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "text",
          "category",
          "component",
          "parents",
          "parent_text",
          "other_parents",
          "related_tsr",
          "verification",
          "baseline_impl",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "aou"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "text",
          "credited_in",
          "verification_approach",
          "aou_status",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cybersecurity-goal"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "text",
          "parents",
          "parent_text",
          "cal",
          "protects",
          "rationale",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cybersecurity-requirement"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "text",
          "parents",
          "concept_requirement",
          "cal",
          "other_parents",
          "allocated_to",
          "safety_relation",
          "related_tsr",
          "verification",
          "baseline_impl",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "dataset-requirement"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "text",
          "parents",
          "parent_text",
          "other_parents",
          "verification",
          "baseline_impl",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "fsr"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "text",
          "asil",
          "parents",
          "allocated_to",
          "verification",
          "baseline_impl",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "functional-insufficiency"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "text",
          "fi_type",
          "component",
          "parents",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "functional-modification"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "title",
          "addresses",
          "parents",
          "gap_text",
          "priority",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "hazard"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "title",
          "functions",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "hazardous-event"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "parents",
          "situation",
          "effect",
          "s",
          "e",
          "c",
          "asil",
          "aou_flag",
          "aou_dependency",
          "asil_if_aou_fails",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "hwsr"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "text",
          "asil",
          "parents",
          "parent_text",
          "other_parents",
          "allocated_to",
          "hw_kind",
          "verification",
          "baseline_impl",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "interface-requirement"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "interface",
          "title",
          "owners",
          "open_item",
          "review_ref",
          "status",
          "source"
        ],
        "properties": {
          "status": {
            "enum": [
              "agreed",
              "proposed",
              "withdrawn"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "interface-requirement"
          },
          "status": {
            "const": "agreed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "review_ref": {
            "type": "string"
          },
          "open_item": {
            "type": "null"
          }
        }
      },
      "description": "DQ-129 A: an interface is agreed only through a recorded review and with no open item"
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "safety-goal"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "text",
          "type",
          "asil",
          "asil_if_aou_fails",
          "aou_dependency",
          "parents",
          "safe_state",
          "ftti_ms",
          "ftti_text",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "sotif-hazard"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "text",
          "functions",
          "function_text",
          "situations",
          "shares_event",
          "linked_text",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "swsr"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "text",
          "asil",
          "parents",
          "parent_text",
          "other_parents",
          "allocated_to",
          "verification",
          "acceptance",
          "baseline_impl",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "system-requirement"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "text",
          "type",
          "functions",
          "criterion",
          "verification",
          "baseline_impl",
          "allocated_to",
          "related_text",
          "related_tsr",
          "related_items",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "threat-scenario"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "text",
          "stride",
          "assets",
          "violated_property",
          "damage_text",
          "gap_text",
          "risk",
          "treatment",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "triggering-condition"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "text",
          "category",
          "parents",
          "insufficiencies",
          "evaluation",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tsr"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "kind",
          "text",
          "asil",
          "parents",
          "parent_text",
          "other_parents",
          "allocated_to",
          "verification",
          "baseline_impl",
          "status",
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "hazardous-event",
              "safety-goal"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "asil": {
            "enum": [
              "QM",
              "A",
              "B",
              "C",
              "D"
            ]
          }
        }
      }
    }
  ]
}
