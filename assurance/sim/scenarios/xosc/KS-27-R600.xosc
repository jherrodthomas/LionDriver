<?xml version='1.0' encoding='utf-8'?>
<OpenSCENARIO xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="OpenScenario.xsd">
    <FileHeader description="KS-27 Lead hidden in a ramp curve while accelerating to the set speed, R = 600 m" author="LionDriver simulation track (synthetic scenario, DSR-12)" revMajor="1" revMinor="3" date="2026-10-16T00:00:00"/>
    <ParameterDeclarations>
        <ParameterDeclaration name="EgoSpeed" parameterType="double" value="19.444"/>
        <ParameterDeclaration name="SetSpeedDelta" parameterType="double" value="6.944"/>
        <ParameterDeclaration name="LeadSpeed" parameterType="double" value="0.0"/>
        <ParameterDeclaration name="LeadS" parameterType="double" value="360.0"/>
    </ParameterDeclarations>
    <CatalogLocations/>
    <RoadNetwork>
        <LogicFile filepath="../xodr/KS-27-R600.xodr"/>
    </RoadNetwork>
    <Entities>
        <ScenarioObject name="ego">
            <Vehicle name="corolla_e210" vehicleCategory="car">
                <BoundingBox>
                    <Center x="1.3" y="0.0" z="0.72"/>
                    <Dimensions width="1.781" length="4.63" height="1.43"/>
                </BoundingBox>
                <Performance maxSpeed="69.0" maxDeceleration="9.0" maxAcceleration="4.0"/>
                <Axles>
                    <FrontAxle maxSteering="0.5" wheelDiameter="0.65" trackWidth="1.53" positionX="2.67" positionZ="0.3"/>
                    <RearAxle maxSteering="0.0" wheelDiameter="0.65" trackWidth="1.53" positionX="0.0" positionZ="0.3"/>
                </Axles>
            </Vehicle>
        </ScenarioObject>
        <ScenarioObject name="lead">
            <Vehicle name="lead_car" vehicleCategory="car">
                <BoundingBox>
                    <Center x="1.4" y="0.0" z="0.75"/>
                    <Dimensions width="1.85" length="4.8" height="1.5"/>
                </BoundingBox>
                <Performance maxSpeed="69.0" maxDeceleration="9.0" maxAcceleration="4.0"/>
                <Axles>
                    <FrontAxle maxSteering="0.5" wheelDiameter="0.65" trackWidth="1.6" positionX="2.8" positionZ="0.3"/>
                    <RearAxle maxSteering="0.0" wheelDiameter="0.65" trackWidth="1.6" positionX="0.0" positionZ="0.3"/>
                </Axles>
            </Vehicle>
        </ScenarioObject>
    </Entities>
    <Storyboard>
        <Init>
            <Actions>
                <Private entityRef="ego">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="0" laneId="-1" s="50.0" offset="0.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="$EgoSpeed"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
                <Private entityRef="lead">
                    <PrivateAction>
                        <TeleportAction>
                            <Position>
                                <LanePosition roadId="0" laneId="-1" s="$LeadS" offset="0.0"/>
                            </Position>
                        </TeleportAction>
                    </PrivateAction>
                    <PrivateAction>
                        <LongitudinalAction>
                            <SpeedAction>
                                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                                <SpeedActionTarget>
                                    <AbsoluteTargetSpeed value="$LeadSpeed"/>
                                </SpeedActionTarget>
                            </SpeedAction>
                        </LongitudinalAction>
                    </PrivateAction>
                </Private>
            </Actions>
        </Init>
        <Story name="accelerate_to_set_speed">
            <Act name="accelerate_to_set_speed">
                <ManeuverGroup name="accelerate_to_set_speed" maximumExecutionCount="1">
                    <Actors selectTriggeringEntities="false">
                        <EntityRef entityRef="ego"/>
                    </Actors>
                    <Maneuver name="accelerate_to_set_speed">
                        <Event name="accelerate_to_set_speed" priority="override" maximumExecutionCount="1">
                            <Action name="accelerate_to_set_speed">
                                <PrivateAction>
                                    <LongitudinalAction>
                                        <SpeedAction>
                                            <SpeedActionDynamics dynamicsShape="linear" value="1.5" dynamicsDimension="rate"/>
                                            <SpeedActionTarget>
                                                <AbsoluteTargetSpeed value="${$EgoSpeed + $SetSpeedDelta}"/>
                                            </SpeedActionTarget>
                                        </SpeedAction>
                                    </LongitudinalAction>
                                </PrivateAction>
                            </Action>
                            <StartTrigger>
                                <ConditionGroup>
                                    <Condition name="at_0.5s" delay="0.0" conditionEdge="none">
                                        <ByValueCondition>
                                            <SimulationTimeCondition value="0.5" rule="greaterThan"/>
                                        </ByValueCondition>
                                    </Condition>
                                </ConditionGroup>
                            </StartTrigger>
                        </Event>
                    </Maneuver>
                </ManeuverGroup>
                <StartTrigger>
                    <ConditionGroup>
                        <Condition name="at_0s" delay="0.0" conditionEdge="none">
                            <ByValueCondition>
                                <SimulationTimeCondition value="0.0" rule="greaterThan"/>
                            </ByValueCondition>
                        </Condition>
                    </ConditionGroup>
                </StartTrigger>
                <StopTrigger/>
            </Act>
        </Story>
        <StopTrigger>
            <ConditionGroup>
                <Condition name="end" delay="0.0" conditionEdge="none">
                    <ByValueCondition>
                        <SimulationTimeCondition value="20.0" rule="greaterThan"/>
                    </ByValueCondition>
                </Condition>
            </ConditionGroup>
        </StopTrigger>
    </Storyboard>
</OpenSCENARIO>
