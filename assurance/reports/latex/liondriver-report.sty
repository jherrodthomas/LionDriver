% LionDriver report style: the shared preamble of every generated LaTeX report (assurance/reports).
% Hand-written; the reports themselves are generated by build_reports.py and are never edited by hand.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{liondriver-report}[2026/11/18 LionDriver generated reports]
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern,microtype,graphicx,booktabs,longtable,array,xcolor,amssymb,pdflscape}
\RequirePackage[margin=25mm,headheight=14pt]{geometry}
\RequirePackage{fancyhdr}
\RequirePackage[hidelinks]{hyperref}
% reproducible PDF: no random trailer ID; dates come from SOURCE_DATE_EPOCH with FORCE_SOURCE_DATE=1
\pdftrailerid{}
\newcommand{\LDdoc}{}
\newcommand{\LDversion}{}
\newcommand{\LDsetdoc}[2]{\renewcommand{\LDdoc}{#1}\renewcommand{\LDversion}{#2}}
\pagestyle{fancy}\fancyhf{}
\fancyhead[L]{\small\LDdoc}
\fancyhead[R]{\small version \LDversion}
\fancyfoot[C]{\thepage}
\fancyfoot[R]{\scriptsize\color{gray}generated from the record; do not edit}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}}
% marks used in the records
\newcommand{\warn}{\textsuperscript{\(\triangle\)}}
\newcommand{\dagr}{\(^\ddagger\)}
\setlength{\LTpre}{6pt}\setlength{\LTpost}{6pt}
\renewcommand{\arraystretch}{1.15}
\endinput
