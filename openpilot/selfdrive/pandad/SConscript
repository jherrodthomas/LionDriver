Import('env', 'arch', 'common', 'messaging', 'liondriver_reference')

if arch != "Darwin":
  libs = [common, messaging, 'pthread']
  panda = env.Library('panda', ['panda.cc', 'spi.cc'])

  # LionDriver (TSR-619): in a reference build pandad configures a car safety mode only on a panda that reports
  # HEALTH_FLAG_REFERENCE_BUILD, i.e. firmware with the safety-mode lock
  pandad_env = env.Clone()
  if liondriver_reference:
    pandad_env.Append(CPPDEFINES=['LIONDRIVER_REFERENCE'])
  pandad_env.Program('pandad', ['main.cc', 'pandad.cc', 'panda_safety.cc'], LIBS=[panda] + libs)

  if GetOption('extras'):
    env.Program('tests/test_pandad_canprotocol', ['tests/test_pandad_canprotocol.cc'], LIBS=[panda] + libs)
